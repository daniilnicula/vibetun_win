<Window x:Class="GoreBox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:v="clr-namespace:GoreBox.Views"
        xmlns:ctl="clr-namespace:GoreBox.Views.Controls"
        Title="GoreBox"
        Width="1060" Height="740" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Windows 10: прозрачное окно + скруглённый Border с клипом. Windows 11: углы DWM. -->
    <Border x:Name="RootBorder" CornerRadius="0" Background="{DynamicResource WindowBg}"
            SizeChanged="OnRootSizeChanged">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= верхняя полоса: марка + кнопки окна ================= -->
        <Border Grid.Row="0" Background="{DynamicResource WindowBg}">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <!-- значок: тайл и знак как в app.ico; цвета меняются с темой (LogoTile*, знак — LogoGradient = акцент) -->
                    <Grid Width="22" Height="22">
                        <Border CornerRadius="5" Background="{DynamicResource LogoTileBg}"
                                BorderBrush="{DynamicResource LogoTileStroke}" BorderThickness="1" />
                        <Border CornerRadius="4,4,0,0" Margin="1,1,1,0" Height="10" VerticalAlignment="Top"
                                Background="{DynamicResource LogoGloss}" />
                        <Viewbox Width="22" Height="22" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 12.04,5.59 L 6.55,18.41 M 12.04,5.59 L 17.46,18.41"
                                      Stroke="{DynamicResource LogoGradient}" StrokeThickness="3.18"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path Data="M 9.75,12.35 L 13.69,18.47"
                                      Stroke="{DynamicResource LogoGradient}" StrokeThickness="2.35"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="GoreBox" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnCaption}" Click="OnAccentClick"
                            ToolTip="Цвет акцента">
                        <Ellipse Width="13" Height="13" Fill="{DynamicResource Accent}"
                                 Stroke="{DynamicResource TextSecondary}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Сменить тему">
                        <Grid Width="14" Height="14">
                            <Path x:Name="sun" Data="M 7,0.8 A 6.2,6.2 0 1 1 6.99,0.8 Z" Width="14" Height="14"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2" Fill="Transparent"
                                  Visibility="{Binding IsDark, Converter={StaticResource InvBoolToVis}}" />
                            <Path Data="M 5.6,1.2 A 6.1,6.1 0 1 0 12.4,9.6 A 5.1,5.1 0 1 1 5.6,1.2 Z"
                                  Width="14" Height="14" Fill="{DynamicResource TextSecondary}"
                                  Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" Click="OnMinimizeClick" ToolTip="Свернуть">
                        <Path Data="M 0,0 H 11" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"
                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" Click="OnMaximizeClick" ToolTip="Развернуть">
                        <Path Data="M 0,0 H 10.5 V 10.5 H 0 Z" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2"
                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource BtnCaptionClose}" Click="OnCloseClick" ToolTip="Закрыть в трей">
                        <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= основная область ============================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- сайдбар -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource Divider}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- вкладки можно перетаскивать ЛКМ; порядок сохраняется (логика в MainWindow.xaml.cs) -->
                    <Grid x:Name="NavHost" Grid.Row="0" Margin="10,12,10,0">
                    <!-- подсветка выбранной вкладки: одна на весь список, переезжает к новой (SlideMarker, MainWindow.xaml.cs) -->
                    <Border x:Name="NavMarker" CornerRadius="9" Background="{DynamicResource AccentSoft}"
                            Visibility="Collapsed">
                        <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ListBox x:Name="NavList" Style="{StaticResource ListNav}" Margin="0"
                             SelectedValue="{Binding ActiveTab}" SelectedValuePath="Tag"
                             PreviewMouseLeftButtonDown="OnNavPreviewMouseDown"
                             PreviewMouseMove="OnNavPreviewMouseMove"
                             PreviewMouseLeftButtonUp="OnNavPreviewMouseUp"
                             LostMouseCapture="OnNavLostCapture">
                        <ListBoxItem Tag="profiles">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20.5,7.2 A3.1,3.1 0 1 1 14.3,7.2 A3.1,3.1 0 1 1 20.5,7.2 M14.2,19.4 Q15,15 20.6,14.4"
                                          Stroke="{DynamicResource Accent}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M13,7.6 A3.6,3.6 0 1 1 5.8,7.6 A3.6,3.6 0 1 1 13,7.6 M3.2,19.6 a6.4,6.4 0 0 1 12.6,0"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                                <TextBlock Text="Профили" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="routing">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M7.4,12 H9.8 M9.8,12 L15.9,7.9 M9.8,12 L14.6,15.9 M7.4,12 A2.6,2.6 0 1 1 2.2,12 A2.6,2.6 0 1 1 7.4,12 M18.8,17.4 A2.6,2.6 0 1 1 13.6,17.4 A2.6,2.6 0 1 1 18.8,17.4"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M21.4,6.8 A3,3 0 1 1 15.4,6.8 A3,3 0 1 1 21.4,6.8"
                                          Stroke="{DynamicResource Accent}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                                <TextBlock Text="Маршрутизация" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="dns">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                                <Path Data="M12,3.6 A3.9,8.4 0 1 1 12,20.4 A3.9,8.4 0 1 1 12,3.6 M3.6,12 H20.4"
      Stroke="{DynamicResource Accent}" StrokeThickness="2.1"
      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
      StrokeLineJoin="Round" />
                                                <Path Data="M20.6,12 A8.6,8.6 0 1 1 3.4,12 A8.6,8.6 0 1 1 20.6,12"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    
                                </Canvas>
                            </Viewbox>
                                <TextBlock Text="DNS" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20.47,10.51 L20.47,13.49 L18.43,13.48 L17.6,15.5 L19.04,16.93 L16.93,19.04 L15.5,17.6 L13.48,18.43 L13.49,20.47 L10.51,20.47 L10.52,18.43 L8.5,17.6 L7.07,19.04 L4.96,16.93 L6.4,15.5 L5.57,13.48 L3.53,13.49 L3.53,10.51 L5.57,10.52 L6.4,8.5 L4.96,7.07 L7.07,4.96 L8.5,6.4 L10.52,5.57 L10.51,3.53 L13.49,3.53 L13.48,5.57 L15.5,6.4 L16.93,4.96 L19.04,7.07 L17.6,8.5 L18.43,10.52 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12"
                                          Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                                <TextBlock Text="Настройки" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="updates">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4.2,14.8 V17.5 A2.5,2.5 0 0 0 6.7,20 H17.3 A2.5,2.5 0 0 0 19.8,17.5 V14.8"
                                              Stroke="{DynamicResource TextPrimary}" StrokeThickness="2.1"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M12,3.8 V14.4 M7.8,10.4 L12,14.6 L16.2,10.4"
                                              Stroke="{DynamicResource Accent}" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Обновление" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- разделы «Панели» и «SSH»: клик по заголовку только раскрывает список
                             (вкладку не переключает), сами разделы перетаскиваются вместе с вкладками;
                             не подсвечиваются — акцент только на конкретной открытой записи.
                             Строки записей + кнопка «+» рисуются кодом (NavSectionMenu). -->
                        <ListBoxItem Tag="panel" Style="{StaticResource NavSectionItem}">
                            <StackPanel>
                        <Border x:Name="PanelHeader" Style="{StaticResource NavSectionHeader}" PreviewMouseLeftButtonDown="OnNavHeaderMouseDown"
                                MouseLeftButtonUp="OnPanelHeaderClick">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="14,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5.5,4.5 H18.5 A2,2 0 0 1 20.5,6.5 V17.5 A2,2 0 0 1 18.5,19.5 H5.5 A2,2 0 0 1 3.5,17.5 V6.5 A2,2 0 0 1 5.5,4.5 Z M16.6,12.4 H18.6 M16.6,15.2 H18.6"
                                                  Stroke="{DynamicResource TextPrimary}" StrokeThickness="2.1"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <Path Data="M7.6,15.4 V12.6 M11.2,15.4 V8.8 M14.8,15.4 V10.6"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Панели" VerticalAlignment="Center" />
                                </StackPanel>
                                <Path Data="M0,0 L5,5 L10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="PanelChevronRot" CenterX="5" CenterY="2.5" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <Border x:Name="PanelMenuBox" ClipToBounds="True" Visibility="Collapsed">
                            <StackPanel x:Name="PanelMenu" Margin="14,4,14,2" />
                        </Border>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="ssh" Style="{StaticResource NavSectionItem}">
                            <StackPanel>
                        <Border x:Name="SshHeader" Style="{StaticResource NavSectionHeader}" Margin="0,2,0,0"
                                PreviewMouseLeftButtonDown="OnNavHeaderMouseDown"
                                MouseLeftButtonUp="OnSshHeaderClick">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="14,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5.5,4.5 H18.5 A2,2 0 0 1 20.5,6.5 V17.5 A2,2 0 0 1 18.5,19.5 H5.5 A2,2 0 0 1 3.5,17.5 V6.5 A2,2 0 0 1 5.5,4.5 Z"
                                                  Stroke="{DynamicResource TextPrimary}" StrokeThickness="2.1"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <Path Data="M7.4,9.4 L10.6,12.6 L7.4,15.8 M13,15.8 H16.4"
                                                  Stroke="{DynamicResource Accent}" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="SSH" VerticalAlignment="Center" />
                                </StackPanel>
                                <Path Data="M0,0 L5,5 L10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SshChevronRot" CenterX="5" CenterY="2.5" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <Border x:Name="SshMenuBox" ClipToBounds="True" Visibility="Collapsed">
                            <StackPanel x:Name="SshMenu" Margin="14,4,14,2" />
                        </Border>
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="14,0,14,10">
                        <TextBlock Text="Активный профиль" Style="{StaticResource TxtCaption}" Margin="2,0,0,6" />
                        <TextBlock Text="{Binding ActiveProfileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding ActiveProfileSubtitle}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>

                    <v:ConnectionCard Grid.Row="2" Margin="12,0,12,12" />
                </Grid>
            </Border>

            <!-- страницы -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- баннер: ядро не найдено -->
                <Border Grid.Row="0" Margin="18,14,18,0" Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource WarningSoft}"
                        Visibility="{Binding Preferences.CoreMissing, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ядро sing-box не найдено" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" />
                            <TextBlock Text="Без ядра прокси не запустится. Установите его автоматически или укажите путь вручную."
                                       Style="{StaticResource TxtMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Установить ядро" Style="{StaticResource BtnPrimary}"
                                Command="{Binding InstallCoreCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- страницы листаются по вертикали; направление — по позиции пункта в левом списке -->
                <ctl:SlideHost x:Name="MainPages" Grid.Row="1" Vertical="True"
                               SelectedKey="{Binding DataContext.ActiveTab, RelativeSource={RelativeSource AncestorType=Window}}">
                    <v:ProfilesView ctl:SlideHost.Key="profiles" DataContext="{Binding Profiles}" />
                    <v:RoutingView ctl:SlideHost.Key="routing" DataContext="{Binding Routing}" />
                    <v:DnsView ctl:SlideHost.Key="dns" DataContext="{Binding Dns}" />
                    <v:SettingsView ctl:SlideHost.Key="settings" DataContext="{Binding Preferences}" Loaded="SettingsView_Loaded" />
                    <v:UpdatesView ctl:SlideHost.Key="updates" DataContext="{Binding Updates}" />
                    <v:PanelView x:Name="PanelTab" ctl:SlideHost.Key="panel" />
                    <v:SshView x:Name="SshTab" ctl:SlideHost.Key="ssh" />
                </ctl:SlideHost>

                <!-- строка состояния -->
                <Border Grid.Row="2" Margin="18,10,18,14" Padding="12,6" CornerRadius="8"
                        Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <Button Grid.Column="1" Content="Логи" Style="{StaticResource BtnSmall}"
                                Command="{Binding ShowLogCommand}" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================= пикер акцента ============================= -->
        <Border x:Name="AccentOverlay" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed"
                MouseLeftButtonDown="OnAccentOverlayClick">
            <Border Style="{StaticResource Card}" Width="264" Padding="16,14" Margin="0,0,154,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" MouseLeftButtonDown="AccentCard_Click">
                <StackPanel>
                    <TextBlock Text="Цвет акцента" Style="{StaticResource TxtH2}" />

                    <!-- цветовой круг: кольцо оттенка и квадрат насыщенности и яркости -->
                    <ctl:ColorWheel x:Name="AccentWheel" Width="216" Height="216" Margin="0,12,0,0"
                                    HorizontalAlignment="Center" ColorChanged="OnAccentWheelChanged" />

                    <!-- прозрачность: тонкая полоска без ползунка; заполнение показывает долю непрозрачности -->
                    <ctl:AlphaBar x:Name="AccentAlpha" Height="14" Margin="0,10,0,0"
                                  AlphaChanged="OnAccentAlphaChanged" ToolTip="Прозрачность" />

                    <Border x:Name="AccentPreview" Height="30" CornerRadius="8" Margin="0,12,0,0"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" />

                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="AccentHexText" Style="{StaticResource TxtMono}"
                                   VerticalAlignment="Center" />
                        <Button Content="По умолчанию" Style="{StaticResource BtnGhost}"
                                HorizontalAlignment="Right" Click="OnAccentReset" />
                    </Grid>

                    <TextBlock Text="Сохраняется сразу и действует для обеих тем." Style="{StaticResource TxtMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>
</Window>
