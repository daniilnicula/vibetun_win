<!-- Dark theme palette -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColAccent">#758AAC</Color>
    <Color x:Key="ColAccentHover">#889AB8</Color>
    <Color x:Key="ColAccentPressed">#677997</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#191B1D" />
    <SolidColorBrush x:Key="PanelBg" Color="#1F2226" />
    <SolidColorBrush x:Key="CardBg" Color="#242830" />
    <SolidColorBrush x:Key="CardBgAlt" Color="#2A2F38" />
    <SolidColorBrush x:Key="CardHover" Color="#2E343D" />
    <SolidColorBrush x:Key="InputBg" Color="#20242A" />
    <SolidColorBrush x:Key="InputBorder" Color="#343A44" />
    <SolidColorBrush x:Key="Border" Color="#2C3138" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A4049" />
    <SolidColorBrush x:Key="Divider" Color="#272C33" />

    <SolidColorBrush x:Key="TextPrimary" Color="#E9EBEE" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A7AEB8" />
    <SolidColorBrush x:Key="TextMuted" Color="#6C7480" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Accent" Color="#758AAC" />
    <SolidColorBrush x:Key="AccentHover" Color="#889AB8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#677997" />
    <SolidColorBrush x:Key="AccentSoft" Color="#333C4B" />

    <SolidColorBrush x:Key="Success" Color="#3BC08A" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#1E3A30" />
    <SolidColorBrush x:Key="Warning" Color="#E5B24B" />
    <SolidColorBrush x:Key="WarningSoft" Color="#3B3320" />
    <SolidColorBrush x:Key="RollbackOrange" Color="#E67E22" />
    <SolidColorBrush x:Key="Danger" Color="#E5646B" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3E2429" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#3C434D" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4A525E" />
    <SolidColorBrush x:Key="WindowCtlHover" Color="#2E333A" />
    <SolidColorBrush x:Key="WindowCtlCloseHover" Color="#D64545" />
    <SolidColorBrush x:Key="Overlay" Color="#B3000000" />
    <SolidColorBrush x:Key="TooltipBg" Color="#2E343D" />
    <SolidColorBrush x:Key="SelectionBg" Color="#31394A" />

    <!-- тайл значка в углу: как у app.ico (тёмный скруглённый квадрат с бликом), цвета — тёмной темы -->
    <LinearGradientBrush x:Key="LogoTileBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E313B" Offset="0" />
        <GradientStop Color="#14161B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoTileStroke" Color="#3D424D" />
    <LinearGradientBrush x:Key="LogoGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#889AB8" Offset="0" />
        <GradientStop Color="#677997" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
