<!-- Light theme palette -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColAccent">#758AAC</Color>
    <Color x:Key="ColAccentHover">#889AB8</Color>
    <Color x:Key="ColAccentPressed">#677997</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#F4F5F7" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBgAlt" Color="#F7F8FA" />
    <SolidColorBrush x:Key="CardHover" Color="#F0F2F6" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#D8DCE3" />
    <SolidColorBrush x:Key="Border" Color="#E4E7EC" />
    <SolidColorBrush x:Key="BorderStrong" Color="#D2D7DF" />
    <SolidColorBrush x:Key="Divider" Color="#ECEEF1" />

    <SolidColorBrush x:Key="TextPrimary" Color="#1D2024" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5C6570" />
    <SolidColorBrush x:Key="TextMuted" Color="#8B929C" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Accent" Color="#758AAC" />
    <SolidColorBrush x:Key="AccentHover" Color="#889AB8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#677997" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E3ECF6" />

    <SolidColorBrush x:Key="Success" Color="#1F9D6B" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#E1F5EC" />
    <SolidColorBrush x:Key="Warning" Color="#B57C14" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FBF0D8" />
    <SolidColorBrush x:Key="RollbackOrange" Color="#E67E22" />
    <SolidColorBrush x:Key="Danger" Color="#D14343" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FBE7E7" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#C9CED6" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#ADB4BF" />
    <SolidColorBrush x:Key="WindowCtlHover" Color="#E8EAEE" />
    <SolidColorBrush x:Key="WindowCtlCloseHover" Color="#E04343" />
    <SolidColorBrush x:Key="Overlay" Color="#59000000" />
    <SolidColorBrush x:Key="TooltipBg" Color="#2B2F36" />
    <SolidColorBrush x:Key="SelectionBg" Color="#E3ECFB" />

    <!-- тайл значка в углу: как у app.ico (скруглённый квадрат с бликом), цвета — светлой темы -->
    <LinearGradientBrush x:Key="LogoTileBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E3E7EE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoTileStroke" Color="#C9CFDA" />
    <LinearGradientBrush x:Key="LogoGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#889AB8" Offset="0" />
        <GradientStop Color="#677997" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
