<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VibeTun</AssemblyName>
    <RootNamespace>VibeTun</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>VibeTun</Product>
    <Company>VibeTun</Company>
    <Description>Minimal proxy / VPN client: sing-box core, per-app routing, profiles, tray</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- RID по умолчанию: без него сборка из CLI требует явного -r win-x64 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);CA1416;NETSDK1137;WFAC010</NoWarn>
    <!-- single file publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\strings.json" LogicalName="VibeTun.Localization.strings.json" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-gray.ico" />
  </ItemGroup>

  <!-- gRPC-клиент ядра (core/nekoray/go/grpc_server/gen/libcore.proto, зеркало в Protos\):
       nekobox_core умеет режим «nekobox -token … -port …» — Start/Stop/Test/QueryStats по RPC.
       Grpc.Tools генерирует клиентские стабы при сборке; без сети NuGet сборка не пройдёт. -->
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Protobuf Include="Protos\libcore.proto" GrpcServices="Client" />
    <!-- вкладка «Панель»: браузер; вкладка «SSH»: клиент ssh-подключений -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1938.49" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- шифрование сохранённых паролей «Панелей» (DPAPI) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>


  <!-- ===================== встроенные ядра sing-box =====================
       Файлы готовит инструмент tools/CoreBundler (скачивает релиз с GitHub и сжимает Brotli).
       Сборка работает и без них — тогда приложение предложит скачать ядро при первом запуске. -->
  <ItemGroup Condition="Exists('Assets/Core/$(RuntimeIdentifier)/sing-box.br')">
    <EmbeddedResource Include="Assets/Core/$(RuntimeIdentifier)/sing-box.br" LogicalName="core/sing-box.br" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Assets/Core/$(RuntimeIdentifier)/sing-box-extended.br')">
    <EmbeddedResource Include="Assets/Core/$(RuntimeIdentifier)/sing-box-extended.br" LogicalName="core/sing-box-extended.br" />
  </ItemGroup>

</Project>
