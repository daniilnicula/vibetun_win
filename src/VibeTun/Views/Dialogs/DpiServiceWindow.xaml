<Window x:Class="VibeTun.Views.Dialogs.DpiServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VibeTun.Services"
        xmlns:ctl="clr-namespace:VibeTun.Views.Controls"
        Title="DPI"
        Width="660" Height="700" MinWidth="560" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Loaded="OnLoaded" PreviewKeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- шапка окна: как у остальных диалогов приложения -->
        <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- сервис, приёмы обхода и профили настроек -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
            <StackPanel Margin="18,0,18,0">

                <!-- ======================= сервис ======================= -->
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ServiceHeader}" Style="{StaticResource TxtH2}" />

                        <!-- «Общие»: имя задано, домены не нужны — набор применяется ко всему трафику -->
                        <TextBlock Text="{Binding GeneralText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,14,0,0"
                              Visibility="{Binding IsService, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr S0027}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" MaxLength="64"
                                         Tag="Discord" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Tr dpi.window.domain}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         FontFamily="Cascadia Mono, Consolas, Courier New" Tag="discord.com"
                                         Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Tr dpi.window.domainHint}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DomainProblem}" Foreground="{DynamicResource Warning}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasDomainProblem, Converter={StaticResource BoolToVis}}" />

                        <!-- служебные домены площадки: без них открывается страница, а картинки и вложения — нет -->
                        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource WarningSoft}"
                                Visibility="{Binding HasRelatedDomains, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RelatedText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                        Content="{loc:Tr dpi.window.relatedAdd}"
                                        Command="{Binding AddRelatedCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======================= приёмы обхода ======================= -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dpi.window.strategy}" Style="{StaticResource TxtH2}" />
                        <TextBlock Text="{Binding StrategySummary}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Accent}" />

                        <!-- разрыв ClientHello -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr dpi.field.snisplit}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Combo}" Width="170" Margin="0,0,10,0"
                                      VerticalAlignment="Center" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Strategy.SplitPositionTag}"
                                      IsEnabled="{Binding Strategy.SniSplit}">
                                <ComboBoxItem Content="{loc:Tr dpi.split.sni}" Tag="Sni" />
                                <ComboBoxItem Content="{loc:Tr dpi.split.midsld}" Tag="MidSld" />
                                <ComboBoxItem Content="{loc:Tr dpi.split.first}" Tag="FirstByte" />
                                <ComboBoxItem Content="{loc:Tr dpi.split.second}" Tag="SecondByte" />
                                <ComboBoxItem Content="{loc:Tr dpi.split.mid}" Tag="Mid" />
                            </ComboBox>
                            <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Strategy.SniSplit}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:Tr dpi.field.recordsplit}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Strategy.TlsRecordSplit}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr dpi.field.multisplit}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="70" Margin="0,0,10,0"
                                     Tag="{loc:Tr dpi.field.size}" Text="{Binding Strategy.MultisplitSize}"
                                     Visibility="{Binding Strategy.Multisplit, Converter={StaticResource BoolToVis}}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Strategy.Multisplit}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:Tr dpi.field.disorder}" Style="{StaticResource Txt}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr dpi.field.disorderTip}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Strategy.Disorder}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:Tr dpi.field.oob}" Style="{StaticResource Txt}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr dpi.field.oobTip}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Strategy.OobSplit}" />
                        </Grid>

                        <!-- фейк-пакет -->
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:Tr dpi.field.fake}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Strategy.FakeTtl}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr dpi.field.fakeValue}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="8"
                                         Text="{Binding Strategy.FakeTtlValue}"
                                         IsEnabled="{Binding Strategy.FakeTtl}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Text="{loc:Tr dpi.field.fakeCount}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="1"
                                         Text="{Binding Strategy.FakeCount}"
                                         IsEnabled="{Binding Strategy.FakeTtl}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                <TextBlock Text="{loc:Tr dpi.field.splitdelay}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="5"
                                         Text="{Binding Strategy.SplitDelayMs}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{loc:Tr dpi.field.autottl}" Style="{StaticResource TxtMuted}" />
                                <ToggleButton Style="{StaticResource Switch}" Margin="0,4,0,0"
                                              IsChecked="{Binding Strategy.FakeAutoTtl}"
                                              IsEnabled="{Binding Strategy.FakeTtl}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr dpi.field.fakesni}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="www.google.com"
                                         FontFamily="Cascadia Mono, Consolas, Courier New"
                                         Text="{Binding Strategy.FakeSni}"
                                         IsEnabled="{Binding Strategy.FakeTtl}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Tr dpi.field.fakeAfter}" Style="{StaticResource TxtMuted}" />
                                <ToggleButton Style="{StaticResource Switch}" Margin="0,4,0,0"
                                              IsChecked="{Binding Strategy.FakeAfter}"
                                              IsEnabled="{Binding Strategy.FakeTtl}" />
                            </StackPanel>
                        </Grid>

                        <!-- обманка фейка и его место в потоке: без этого фейк либо доходит
                             до сервера, либо уходит не в тот поток — как было раньше -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr dpi.field.fooling}" Style="{StaticResource TxtMuted}"
                                           ToolTip="{loc:Tr dpi.field.foolingTip}" />
                                <ComboBox Style="{StaticResource Combo}" Margin="0,4,0,0" SelectedValuePath="Tag"
                                          SelectedValue="{Binding Strategy.FakeFoolingTag}"
                                          IsEnabled="{Binding Strategy.FakeTtl}">
                                    <ComboBoxItem Content="{loc:Tr dpi.fool.ttl}" Tag="Ttl" />
                                    <ComboBoxItem Content="{loc:Tr dpi.fool.badsum}" Tag="BadSum" />
                                    <ComboBoxItem Content="{loc:Tr dpi.fool.badseq}" Tag="BadSeq" />
                                    <ComboBoxItem Content="{loc:Tr dpi.fool.noack}" Tag="DataNoAck" />
                                    <ComboBoxItem Content="{loc:Tr dpi.fool.tltsum}" Tag="16" />
                                    <ComboBoxItem Content="{loc:Tr dpi.fool.none}" Tag="None" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Tr dpi.field.placement}" Style="{StaticResource TxtMuted}"
                                           ToolTip="{loc:Tr dpi.field.placementTip}" />
                                <ComboBox Style="{StaticResource Combo}" Margin="0,4,0,0" SelectedValuePath="Tag"
                                          SelectedValue="{Binding Strategy.FakePlacementTag}"
                                          IsEnabled="{Binding Strategy.FakeTtl}">
                                    <ComboBoxItem Content="{loc:Tr dpi.place.overlap}" Tag="Overlap" />
                                    <ComboBoxItem Content="{loc:Tr dpi.place.ahead}" Tag="Ahead" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{loc:Tr dpi.field.inject}" Style="{StaticResource Txt}" VerticalAlignment="Center"
                                       ToolTip="{loc:Tr dpi.field.injectTip}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Strategy.InjectFake}"
                                          IsEnabled="{Binding Strategy.FakeTtl}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr dpi.field.mss}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="70" Margin="0,0,10,0"
                                     Tag="{loc:Tr dpi.field.mssValue}" Text="{Binding Strategy.MssValue}"
                                     Visibility="{Binding Strategy.ClampMss, Converter={StaticResource BoolToVis}}" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                          IsChecked="{Binding Strategy.ClampMss}" />
                        </Grid>

                        <!-- перебор стратегий сервиса: если первая не откроет поток, движок
                             берёт следующую из подобранных профилей (как очередь правил в zapret) -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr dpi.field.failover}" Style="{StaticResource TxtMuted}"
                                           ToolTip="{loc:Tr dpi.field.failoverTip}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="3"
                                         Text="{Binding Strategy.FailoverCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Tr dpi.field.failoverWait}" Style="{StaticResource TxtMuted}"
                                           ToolTip="{loc:Tr dpi.field.failoverTip}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="5000"
                                         Text="{Binding Strategy.FailoverTimeoutMs}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Tr dpi.window.fieldHint}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- ======================= транспорт «Общих» ======================= -->
                <!-- порт, задержка, режим выхода и системный прокси: раньше это было в «Настройках»
                     → «Обход DPI», теперь настраивается только здесь -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0"
                        Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dpi.window.transport}" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Tr S0008}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="9910"
                                         Text="{Binding Port}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Tr dpi.window.exit}" Style="{StaticResource TxtMuted}" />
                                <Grid Margin="0,4,0,0" ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="7">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SegToggle}" Content="{loc:Tr S0222}"
                                                      IsChecked="{Binding ExitDirect}" />
                                        <ToggleButton Style="{StaticResource SegToggleNeutral}" Content="{loc:Tr S0223}"
                                                      Margin="2,0,0,0" IsChecked="{Binding ExitProxy}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Tr S0225}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UseSystemProxy}" />
                        </Grid>

                        <TextBlock Text="{loc:Tr dpi.window.transportHint}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- ======================= DNS сервиса ======================= -->
                <!-- каким сервером спрашивать адреса доменов: выбор живёт в разделе «DNS» — там же,
                     где DNS для домена и приложения -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr dpi.window.dns}" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DnsText}" Style="{StaticResource Txt}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Accent}" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="{loc:Tr dpi.window.dnsPick}" Style="{StaticResource BtnGhost}"
                                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanSave}" Click="OnPickDns"
                                    ToolTip="{Binding DnsPickHint}" />
                            <Button Grid.Column="2" Content="{loc:Tr dpi.window.dnsClear}" Style="{StaticResource BtnGhost}"
                                    Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding ClearDnsCommand}"
                                    Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Text="{loc:Tr dpi.window.dnsHint}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ======================= профили настроек ======================= -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{loc:Tr dpi.window.profiles}" Style="{StaticResource TxtH2}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{loc:Tr dpi.profile.saveBtn}" Style="{StaticResource BtnGhost}"
                                        Padding="10,4" FontSize="12" Command="{Binding UpdateProfileCommand}"
                                        ToolTip="{loc:Tr dpi.window.profilesHint}" />
                                <Button Content="{loc:Tr dpi.profile.new}" Style="{StaticResource BtnGhost}"
                                        Padding="10,4" FontSize="12" Margin="6,0,0,0" Command="{Binding NewProfileCommand}" />
                                <Button Content="{loc:Tr dpi.profile.importBtn}" Style="{StaticResource BtnGhost}"
                                        Padding="10,4" FontSize="12" Margin="6,0,0,0"
                                        Command="{Binding ImportProfileCommand}"
                                        ToolTip="{loc:Tr dpi.window.profilesHint}" />
                                <Button Content="{loc:Tr dpi.btn.common}" Style="{StaticResource BtnGhost}"
                                        Padding="10,4" FontSize="12" Margin="6,0,0,0"
                                        Command="{Binding UseCommonCommand}"
                                        Visibility="{Binding IsService, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Tr dpi.window.profilesHint}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <ListBox Style="{StaticResource ListPlainRows}" Margin="0,10,0,0" MaxHeight="240"
                                 ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="10,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="6" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoft}"
                                                        Visibility="{Binding IsAuto, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Tr dpi.profile.auto}" FontSize="11"
                                                               Foreground="{DynamicResource Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource TxtMuted}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" Style="{StaticResource TxtMuted}"
                                                   FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Button Style="{StaticResource BtnIcon}" ToolTip="{loc:Tr dpi.profile.renameBtn}"
                                                    Command="{Binding DataContext.RenameProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextSecondary}"
                                                      Data="M 8.9,1.4 L 10.6,3.1 L 4.1,9.6 L 1.6,10.4 L 2.4,7.9 Z" />
                                            </Button>
                                            <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="{loc:Tr dpi.profile.exportBtn}"
                                                    Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Data="M2.5,8.4 V10.5 A1.8,1.8 0 0 0 4.3,12.3 H9.7 A1.8,1.8 0 0 0 11.5,10.5 V8.4 M7,8.6 V2.2 M4.5,4.7 L7,2.2 L9.5,4.7" />
                                            </Button>
                                            <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="{loc:Tr S0083}"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{DynamicResource Warning}"
                                                      Data="M 2.6,2.6 L 9.4,9.4 M 9.4,2.6 L 2.6,9.4" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding ProfileHint}" Style="{StaticResource TxtMuted}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================= журнал проверки ======================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="18,6,18,0" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Grid Margin="14,8,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr S0022}" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource TxtMuted}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ProgressText, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{loc:Tr S0074}" Style="{StaticResource BtnSmall}" Click="OnLogCopyClick" />
                        <Button Content="{loc:Tr S0034}" Style="{StaticResource BtnSmall}" Margin="6,0,0,0"
                                Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="LogScroll" Grid.Row="1" Padding="8,2,8,8" Margin="0,0,0,0"
                              Background="Transparent" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log.Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <ctl:LogLineText Segments="{Binding Segments}" Style="{StaticResource TxtMono}"
                                                     TextWrapping="NoWrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ======================= нижние кнопки ======================= -->
        <Grid Grid.Row="3" Margin="18,12,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TxtMuted}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Tr dpi.btn.stop}" Style="{StaticResource BtnGhost}" Click="OnStop"
                        Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="TestButton" Content="{loc:Tr dpi.btn.test}" Style="{StaticResource BtnGhost}"
                        Margin="8,0,0,0" Command="{Binding TestCommand}" />
                <Button x:Name="AutoButton" Content="{loc:Tr dpi.btn.auto}" Style="{StaticResource BtnPrimary}"
                        Margin="8,0,0,0" Command="{Binding AutoCommand}" />
                <Button Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Margin="16,0,0,0" Click="OnCancel" />
                <Button x:Name="SaveButton" Content="{loc:Tr dpi.btn.save}" Style="{StaticResource BtnPrimary}"
                        Margin="8,0,0,0" IsDefault="True" IsEnabled="{Binding CanSave}" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
