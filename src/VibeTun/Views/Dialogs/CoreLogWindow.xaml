<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.CoreLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
             xmlns:loc="clr-namespace:VibeTun.Services"
        Title="{loc:Tr S0022}" Width="720" Height="520" MinWidth="520" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock x:Name="TitleText" Text="{loc:Tr S0023}" FontWeight="SemiBold" Margin="18,0,0,0"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <TextBox x:Name="LogText" Grid.Row="1" Margin="18,0,18,0" Style="{StaticResource InputBoxMono}"
                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,14">
            <Button Content="{loc:Tr S0024}" Style="{StaticResource BtnGhost}" Click="OnCopy" />
            <Button Content="{loc:Tr S0017}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnClose" />
        </StackPanel>
    </Grid>
</dlg:DialogWindow>
