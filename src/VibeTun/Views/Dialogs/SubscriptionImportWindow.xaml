<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.SubscriptionImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
        xmlns:ctl="clr-namespace:VibeTun.Views.Controls"
        xmlns:loc="clr-namespace:VibeTun.Services"
        Title="{loc:Tr S0975}" Width="520" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock Text="{loc:Tr S0975}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,12,18,10">
            <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
            <Button Content="{loc:Tr S0979}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch"
                    Margin="0,12,0,0" Padding="12,9" Click="OnAddSubscription"
                    AutomationProperties.AutomationId="SubAddSubscription" />
            <Button Content="{loc:Tr S0980}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch"
                    Margin="0,7,0,0" Padding="12,9" Click="OnAddProfiles"
                    AutomationProperties.AutomationId="SubAddProfiles" />
        </StackPanel>

        <Border Grid.Row="2" Margin="18,0,18,0" Padding="14,12" CornerRadius="10"
                Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel>
                <!-- тот же блок выбора группы, что и внизу окна «Добавить подключение» -->
                <ctl:GroupPicker x:Name="TargetGroup" />
                <Button Content="{loc:Tr S0981}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch"
                        Margin="0,10,0,0" Padding="12,9" Click="OnAddToGroup"
                        AutomationProperties.AutomationId="SubAddToGroup" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
            <Button Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" MinWidth="96" Click="OnCancel"
                    AutomationProperties.AutomationId="SubCancel" />
        </StackPanel>
    </Grid>
</dlg:DialogWindow>
