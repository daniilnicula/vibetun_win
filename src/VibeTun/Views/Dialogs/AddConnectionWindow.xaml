<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.AddConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
        xmlns:loc="clr-namespace:VibeTun.Services"
        Width="380" Height="400" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        MinWidth="0" MinHeight="0" WindowStartupLocation="Manual" Background="{DynamicResource WindowBg}" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <!-- Одно окно на все шаги: меню, файл, вставка, протокол, группа. Окно растягивается из кнопки-источника,
         а при переходе между шагами меняет размер под содержимое; содержимое проявляется плавно. -->
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock x:Name="HeaderTitle" Margin="18,0,0,0" VerticalAlignment="Center" Opacity="0"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnClose">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="Body" Grid.Row="1" Opacity="0">
            <!-- ===================== главное меню ===================== -->
            <StackPanel x:Name="StepMenu" Margin="14,6,14,16" Visibility="Collapsed">
                <Button Style="{StaticResource BtnGhost}" Tag="10" Padding="14,12" Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch" Click="OnMenuFile">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M3.5,1.5 H9.5 L13,5 V14.5 H3.5 Z M9.5,1.5 V5 H13"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr S1010}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{loc:Tr S1011}" Style="{StaticResource TxtMuted}" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource BtnGhost}" Tag="10" Padding="14,12" Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch" Click="OnMenuClipboard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M5,3 H3.5 V14.5 H12.5 V3 H11 M5.5,1.5 H9.5 V4 H5.5 Z"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr S1012}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{loc:Tr S1013}" Style="{StaticResource TxtMuted}" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource BtnGhost}" Tag="10" Padding="14,12" Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch" Click="OnMenuManual">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M6.5,9.5 L9.5,6.5 M5,8.5 L3.2,10.3 A2.1,2.1 0 0 0 6.2,13.3 L8,11.5 M11,7.5 L12.8,5.7 A2.1,2.1 0 0 0 9.8,2.7 L8,4.5"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr S1014}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{loc:Tr S1015}" Style="{StaticResource TxtMuted}" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource BtnGhost}" Tag="10" Padding="14,12" Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch" Click="OnMenuProtocol">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M10.5,2 A3.2,3.2 0 0 0 7.2,6.2 L2.5,10.9 L5.1,13.5 L9.8,8.8 A3.2,3.2 0 0 0 14,5.5 L11.9,7.6 L9.9,7.1 L9.4,5.1 L11.5,3 Z"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr S0155}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{loc:Tr S1016}" Style="{StaticResource TxtMuted}" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource BtnGhost}" Tag="10" Padding="14,12"
                        HorizontalContentAlignment="Stretch" Click="OnMenuGroup">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M5.5,6.5 A2,2 0 1 0 5.5,2.5 A2,2 0 1 0 5.5,6.5 M1.5,14 C1.5,10.9 3.2,9.8 5.5,9.8 C7.8,9.8 9.5,10.9 9.5,14 M10.5,4.5 A2,2 0 1 0 10.5,8.5 M10.5,9.9 C12.6,10.1 14.5,11.1 14.5,14"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr S0952}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{loc:Tr S1017}" Style="{StaticResource TxtMuted}" FontSize="11.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- ===================== импорт из файла ===================== -->
            <Grid x:Name="StepFile" Margin="18,6,18,18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr S1018}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" />

                <Border x:Name="DropZone" Grid.Row="1" Margin="0,12,0,0" Height="150" CornerRadius="10"
                        Background="{DynamicResource CardBgAlt}" Cursor="Hand" AllowDrop="True"
                        MouseLeftButtonUp="OnDropZoneClick" DragEnter="OnDropZoneDragEnter"
                        DragOver="OnDropZoneDragOver" DragLeave="OnDropZoneDragLeave" Drop="OnDropZoneDrop">
                    <Grid>
                        <Rectangle x:Name="DropStroke" RadiusX="10" RadiusY="10" Margin="0.5"
                                   Stroke="{DynamicResource BorderStrong}" StrokeThickness="1" StrokeDashArray="4,3" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Path Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
                                  Data="M3.5,1.5 H9.5 L13,5 V14.5 H3.5 Z M9.5,1.5 V5 H13"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="{loc:Tr S1019}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{loc:Tr S1020}" Margin="0,3,0,0" HorizontalAlignment="Center"
                                       Style="{StaticResource TxtMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="FileError" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                           Style="{StaticResource TxtMuted}" Foreground="{DynamicResource Danger}" />

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{loc:Tr S1021}" Style="{StaticResource BtnGhost}" Padding="12,8" Click="OnPickFileClick" />
                    <Button Grid.Column="1" Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Padding="14,8" Margin="8,0,0,0" Click="OnBack" />
                </Grid>
            </Grid>

            <!-- ===================== вставка текста (из буфера / вручную) ===================== -->
            <Grid x:Name="StepPaste" Margin="18,6,18,18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PasteSubtitle" Grid.Row="0" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" />

                <TextBox x:Name="PasteInput" Grid.Row="1" Style="{StaticResource InputBoxMono}" Height="170"
                         Margin="0,12,0,0" TextWrapping="Wrap" Tag="{loc:Tr S1022}" TextChanged="OnPasteChanged" />

                <TextBlock x:Name="PasteStatus" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                           Style="{StaticResource TxtMuted}" />

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PasteAdd" Content="{loc:Tr S0029}" Style="{StaticResource BtnPrimary}"
                            Padding="12,8" IsEnabled="False" Click="OnPasteAdd" />
                    <Button Grid.Column="1" Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Padding="14,8" Margin="8,0,0,0" Click="OnBack" />
                </Grid>
            </Grid>

            <!-- ===================== выбор протокола ===================== -->
            <Grid x:Name="StepProtocol" Margin="18,6,18,18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr S1016}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" />

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <ComboBox x:Name="ProtocolCombo" Style="{StaticResource Combo}" DisplayMemberPath="Name"
                                  SelectionChanged="OnProtocolChanged" />
                        <TextBlock x:Name="ProtocolHint" Text="{loc:Tr S1023}" Style="{StaticResource TxtMuted}"
                                   VerticalAlignment="Center" Margin="11,0,30,0" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="1" Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Padding="14,8" Margin="8,0,0,0" Click="OnBack" />
                </Grid>
            </Grid>

            <!-- ===================== создание группы ===================== -->
            <Grid x:Name="StepGroup" Margin="18,6,18,18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr S1024}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" />

                <TextBox x:Name="GroupName" Grid.Row="1" Style="{StaticResource InputBox}" Margin="0,12,0,0"
                         Tag="{loc:Tr S0958}" TextChanged="OnGroupNameChanged" KeyDown="OnGroupNameKeyDown" />

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GroupCreate" Content="{loc:Tr S0952}" Style="{StaticResource BtnPrimary}"
                            Padding="12,8" Click="OnCreateGroup" />
                    <Button Grid.Column="1" Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Padding="14,8" Margin="8,0,0,0" Click="OnBack" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</dlg:DialogWindow>
