<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.CloseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
             xmlns:loc="clr-namespace:VibeTun.Services"
        Title="{loc:Tr S0017}" Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border Background="{DynamicResource WindowBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock Text="{loc:Tr S0018}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,0,18,4">
            <CheckBox x:Name="RememberBox" Style="{StaticResource Check}" Content="{loc:Tr S0019}"
                      Foreground="{DynamicResource TextSecondary}" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
            <Button Content="{loc:Tr S0017}" Style="{StaticResource BtnGhost}" Click="OnExit" />
            <Button Content="{loc:Tr S0020}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnHide" IsDefault="True" />
        </StackPanel>
    </Grid>
    </Border>
</dlg:DialogWindow>
