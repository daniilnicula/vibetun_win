<Window x:Class="VibeTun.Views.Dialogs.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор приложений" Width="620" Height="600" MinWidth="520" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border
         Background="{DynamicResource WindowBg}"
        CornerRadius="12"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="40" MinHeight="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock Text="Добавить приложение" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="18,-2,0,0" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" Click="OnCancel" Padding="1,1,1,1" Grid.IsSharedSizeScope="True" Margin="0,-6,0,0">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,0,18,10">
            <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                       Text="Выберите запущенные приложения или укажите .exe файлы вручную. Отметьте нужные галочками." />
            <Grid Margin="0,10,0,0" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Style="{StaticResource InputBox}" Tag="Поиск по названию или пути"
                         TextChanged="OnSearchChanged" Padding="10,-2,10,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Обновить" Style="{StaticResource BtnGhost}" Click="OnRefresh" Padding="12,-1,12,0" />
                    <Button Content="Выбрать .exe" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="OnPickFile" Padding="12,-1,12,0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <ListBox x:Name="List" Grid.Row="2" Margin="18,0,18,0" Style="{StaticResource ListPlainRows}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center" Margin="10,0,0,0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="7" Margin="10,0,0,0"
                                Background="{DynamicResource CardBgAlt}">
                            <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="2" Margin="10,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" Style="{StaticResource TxtMuted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding PidLabel}" Style="{StaticResource TxtMuted}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="18,0,18,0">
            <TextBlock x:Name="Counter" Style="{StaticResource TxtMuted}" VerticalAlignment="Center" Height="26" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="25" VerticalAlignment="Center">
                <Button Content="Отмена" Style="{StaticResource BtnGhost}" Click="OnCancel" Padding="12,-1,12,0" />
                <Button Content="Добавить выбранные" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnAdd" Padding="12,-1,12,0" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
