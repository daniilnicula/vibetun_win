<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
             xmlns:loc="clr-namespace:VibeTun.Services"
        Title="{loc:Tr S0030}" Width="720" Height="600" MinWidth="560" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock Text="{loc:Tr S0030}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,0,18,10">
            <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                       Text="{loc:Tr S0031}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{loc:Tr S0032}" Style="{StaticResource BtnGhost}" Click="OnPaste" />
                <Button Content="{loc:Tr S0033}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="OnFromFile" />
                <Button Content="{loc:Tr S0034}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="OnClear" />
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="Input" Grid.Row="2" Margin="18,0,18,0" Style="{StaticResource InputBoxMono}"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 TextChanged="OnInputChanged" MinHeight="120" />

        <Grid Grid.Row="3" Margin="18,12,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock x:Name="PreviewTitle" Text="{loc:Tr S0035}" Style="{StaticResource TxtCaption}" />
                <ListBox x:Name="Preview" Style="{StaticResource ListPlainRows}" MaxHeight="150" Margin="0,6,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <!-- ВАЖНО: Run.Text — Two Way по умолчанию, а ProtocolLabel/AddressLabel только для чтения,
                                     поэтому Mode=OneWay здесь обязателен. -->
                                <TextBlock Style="{StaticResource TxtMuted}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ProtocolLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding AddressLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="Errors" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource Danger}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="12,10,0,0">
                <Button Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Click="OnCancel" />
                <Button x:Name="AddButton" Content="{loc:Tr S0029}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                        Click="OnAdd" />
            </StackPanel>
        </Grid>
    </Grid>
</dlg:DialogWindow>
