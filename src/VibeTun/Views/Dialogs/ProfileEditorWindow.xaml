<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
             xmlns:loc="clr-namespace:VibeTun.Services"
        Title="{loc:Tr S0036}" Width="640" Height="720" MinWidth="560" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border Background="{DynamicResource WindowBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource WindowBg}" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock Text="{loc:Tr S0037}" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancel"
                        ToolTip="{loc:Tr S0017}">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
            <StackPanel Margin="0,0,4,12">

                <!-- имя и протокол -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0027}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                 Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{loc:Tr S0038}" Style="{StaticResource TxtMuted}" />
                        <ComboBox Style="{StaticResource Combo}" Margin="0,4,0,0" ItemsSource="{Binding ProtocolList}"
                                  SelectedItem="{Binding Protocol}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ProtocolHint}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="{Binding ProtocolHint, Converter={StaticResource StrToVis}}" />

                <!-- сервер -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0039}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                 Text="{Binding Node.Server, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{loc:Tr S0008}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                 Text="{Binding Node.Port, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="{loc:Tr S0040}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                 Text="{Binding Profile.Group, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- ============ учётные данные ============ -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding Protocol, Converter={StaticResource InListVis}, ConverterParameter='vless,vmess,tuic,socks,http,ssh'}"
                            DataContext="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0041}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.Uuid, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Tr S0042}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.Password, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding Protocol, Converter={StaticResource InListVis}, ConverterParameter='trojan,shadowsocks,hysteria2,hysteria,anytls'}">
                    <TextBlock Text="{loc:Tr S0042}" Style="{StaticResource TxtMuted}" />
                    <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                             Text="{Binding Node.Password, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding Protocol, Converter={StaticResource StrEqualsVis}, ConverterParameter=shadowsocks}">
                    <TextBlock Text="{loc:Tr S0043}" Style="{StaticResource TxtMuted}" />
                    <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="aes-256-gcm, chacha20-ietf-poly1305, 2022-blake3-aes-256-gcm"
                             Text="{Binding Node.Method, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- ============ TLS ============ -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsTlsCapable, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
                    <Grid>
                        <TextBlock Text="{loc:Tr S0044}" Style="{StaticResource TxtH2}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="TLS" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" Margin="8,0,0,0" IsChecked="{Binding Tls}" />
                            <TextBlock Text="REALITY" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <ToggleButton Style="{StaticResource Switch}" Margin="8,0,0,0" IsChecked="{Binding Reality}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0045}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.Sni, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Tr S0046}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="h2, http/1.1"
                                     Text="{Binding Node.Alpn, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0047}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="chrome / firefox / safari"
                                     Text="{Binding Node.Fingerprint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0" Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr S0048}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" Margin="8,0,0,0" IsChecked="{Binding Insecure}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding Reality, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="REALITY public key" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.PublicKey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Short ID" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.ShortId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding Protocol, Converter={StaticResource InListVis}, ConverterParameter='vless,vmess'}">
                        <TextBlock Text="Flow (vless)" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="xtls-rprx-vision"
                                 Text="{Binding Node.Flow, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============ транспорт ============ -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsTransportable, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
                    <TextBlock Text="{loc:Tr S0049}" Style="{StaticResource TxtH2}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0050}" Style="{StaticResource TxtMuted}" />
                            <ComboBox Style="{StaticResource Combo}" Margin="0,4,0,0" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Node.Network}">
                                <ComboBoxItem Content="tcp" Tag="tcp" />
                                <ComboBoxItem Content="ws" Tag="ws" />
                                <ComboBoxItem Content="grpc" Tag="grpc" />
                                <ComboBoxItem Content="http" Tag="http" />
                                <ComboBoxItem Content="httpupgrade" Tag="httpupgrade" />
                                <ComboBoxItem Content="quic" Tag="quic" />
                                <ComboBoxItem Content="xhttp" Tag="xhttp" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Path" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="/path"
                                     Text="{Binding Node.Path, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Tr S0051}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.Host, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="gRPC service name" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                 Text="{Binding Node.ServiceName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============ QUIC-протоколы ============ -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsQuic, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
                    <TextBlock Text="Hysteria / TUIC" Style="{StaticResource TxtH2}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0052}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.UpMbps, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Tr S0053}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.DownMbps, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0054}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.Obfs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Tr S0055}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.ObfsPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Congestion control (TUIC)" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="bbr / cubic / new_reno"
                                     Text="{Binding Node.CongestionControl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="UDP relay mode (TUIC)" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="native / quic"
                                     Text="{Binding Node.UdpRelayMode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ============ WireGuard / AmneziaWG ============ -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsWireGuard, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
                    <TextBlock Text="WireGuard / AmneziaWG" Style="{StaticResource TxtH2}" />
                    <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{loc:Tr S0056}" />

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{loc:Tr S0057}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBoxMono}" Margin="0,4,0,0" Height="52"
                                 Text="{Binding Node.WgPrivateKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{loc:Tr S0058}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBoxMono}" Margin="0,4,0,0" Height="52"
                                 Text="{Binding Node.WgPeerPublicKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{loc:Tr S0059}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBoxMono}" Margin="0,4,0,0" Height="46"
                                 Text="{Binding Node.WgPresharedKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr S0060}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Tag="10.13.13.2/24"
                                     Text="{Binding Node.WgAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="DNS" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.WgDns, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MTU" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.WgMtu, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{loc:Tr S0061}" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.WgKeepalive, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Reserved (0,0,0)" Style="{StaticResource TxtMuted}" />
                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                     Text="{Binding Node.WgReserved, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsAmnezia, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr S0062}" Style="{StaticResource TxtH2}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Jc" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgJc, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Jmin" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgJmin, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Jmax" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgJmax, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="S1" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgS1, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="S2" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgS2, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="S3" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgS3, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="S4" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgS4, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="H1" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgH1, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="H2" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgH2, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="H3" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgH3, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="H4" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgH4, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr S0063}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgI1, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="I2" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgI2, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="I3" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgI3, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="I4" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgI4, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="I5" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgI5, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="HeaderProtectionKey" Style="{StaticResource TxtMuted}" Margin="0,10,0,0" />
                        <TextBox Style="{StaticResource InputBoxMono}" Margin="0,4,0,0"
                                 Text="{Binding Node.AwgHeaderProtectionKey, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ContentPaddingAddition" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgContentPadding, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="MaxHandshakeAttempts" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgMaxHandshakeAttempts, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RekeyAfterTime" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgRekeyAfterTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="RekeyTimeout" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgRekeyTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="RejectAfterTime" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgRejectAfterTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="KeepaliveTimeout" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding Node.AwgKeepaliveTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="RandomTrailers" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Node.AwgRandomTrailers}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="DisableCookies" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding Node.AwgDisableCookies}" />
                        </Grid>
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:Tr S0064}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============ MTProto ============ -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsTelegram, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
                    <TextBlock Text="MTProto (Telegram)" Style="{StaticResource TxtH2}" />
                    <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{loc:Tr S0065}" />
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Secret" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBoxMono}" Margin="0,4,0,0"
                                 Text="{Binding Node.MtSecret, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============ исходники ============ -->
                <StackPanel Margin="0,16,0,0">
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
                    <TextBlock Text="{loc:Tr S0066}" Style="{StaticResource TxtH2}" />
                    <TextBox Style="{StaticResource InputBoxMono}" Margin="0,8,0,0" Height="58"
                             Text="{Binding RawUri, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{loc:Tr S0067}" Style="{StaticResource TxtMuted}" Margin="0,10,0,0" />
                    <TextBox Style="{StaticResource InputBoxMono}" Margin="0,4,0,0" Height="74"
                             Text="{Binding RawJson, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- низ: пинг + кнопки -->
        <Border Grid.Row="2" Padding="18,12" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Tr S0068}" Style="{StaticResource BtnGhost}" Command="{Binding TestPingCommand}" />
                    <TextBlock Text="{Binding PingText}" Style="{StaticResource TxtMono}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Click="OnCancel" />
                    <Button Content="{loc:Tr S0069}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</dlg:DialogWindow>
