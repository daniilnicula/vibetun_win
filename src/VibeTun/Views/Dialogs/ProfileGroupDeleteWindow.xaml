<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.ProfileGroupDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
        xmlns:loc="clr-namespace:VibeTun.Services"
        Title="{loc:Tr S0955}" Width="500" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock Text="{loc:Tr S0955}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <TextBlock x:Name="Message" Grid.Row="1" Margin="18,12,18,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" />

        <Button x:Name="KeepButton" Grid.Row="2" Style="{StaticResource BtnGhost}"
                HorizontalContentAlignment="Stretch" Padding="14,10" Margin="18,0,18,8"
                Click="OnKeepProfiles">
            <StackPanel>
                <TextBlock Text="{loc:Tr S0968}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{loc:Tr S0969}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11" />
            </StackPanel>
        </Button>

        <Button x:Name="DeleteButton" Grid.Row="3" Style="{StaticResource BtnDanger}"
                HorizontalContentAlignment="Stretch" Padding="14,10" Margin="18,0,18,8"
                Click="OnDeleteGroupAndProfiles">
            <StackPanel>
                <TextBlock x:Name="DeleteTitle" Text="{loc:Tr S0970}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Danger}" />
                <TextBlock x:Name="DeleteDescription" Text="{loc:Tr S0971}" Margin="0,3,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
            </StackPanel>
        </Button>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,6,18,16">
            <Button Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" MinWidth="96" Click="OnCancel" />
        </StackPanel>
    </Grid>
</dlg:DialogWindow>
