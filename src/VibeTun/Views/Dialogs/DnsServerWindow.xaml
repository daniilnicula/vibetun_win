<dlg:DialogWindow x:Class="VibeTun.Views.Dialogs.DnsServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:VibeTun.Views.Dialogs"
             xmlns:loc="clr-namespace:VibeTun.Services"
        Title="DNS" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Loaded="OnLoaded" PreviewKeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
            <Grid>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnCaptionClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancel">
                    <Path Data="M 0,0 L 10.5,10.5 M 10.5,0 L 0,10.5" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,0,18,4">
            <TextBlock Text="{loc:Tr S0025}"
                       Style="{StaticResource TxtMuted}" TextWrapping="Wrap" />

            <TextBlock Text="{loc:Tr S0026}" Style="{StaticResource TxtMuted}" Margin="0,12,0,0" />
            <!-- не InputBoxMono: там AcceptsReturn, и Enter вставлял бы перенос вместо «Добавить» -->
            <TextBox x:Name="AddressBox" Style="{StaticResource InputBox}" Margin="0,4,0,0"
                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="{loc:Tr ExampleIP}"
                     KeyDown="OnKeyDown" TextChanged="OnAddressChanged" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

            <TextBlock Text="{loc:Tr S0027}" Style="{StaticResource TxtMuted}" Margin="0,10,0,0" />
            <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,4,0,0" MaxLength="64"
                     Tag="{loc:Tr ExampleDNS}" KeyDown="OnKeyDown" />

            <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="{loc:Tr S0028}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
            <Button Content="{loc:Tr S0015}" Style="{StaticResource BtnGhost}" Click="OnCancel" />
            <Button x:Name="OkButton" Content="{loc:Tr S0029}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                    Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</dlg:DialogWindow>
