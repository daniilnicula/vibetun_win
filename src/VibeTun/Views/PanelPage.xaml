<UserControl x:Class="VibeTun.Views.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- адрес + кнопка обновить -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}" Tag="https://example.com"
                         VerticalContentAlignment="Center" Padding="10,7,36,7"
                         KeyDown="OnUrlKeyDown" LostFocus="OnUrlLostFocus" />
                <Border x:Name="UrlLoadingIndicator" Width="24" Height="24" Margin="0,0,7,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="UrlLoadingRotation" />
                        </Grid.RenderTransform>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="7.5,0,7.5,15" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="12.8,2.2,2.2,12.8" Opacity="0.8" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="15,7.5,0,7.5" Opacity="0.6" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="12.8,12.8,2.2,2.2" Opacity="0.4" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="7.5,15,7.5,0" Opacity="0.25" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="2.2,12.8,12.8,2.2" Opacity="0.15" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="0,7.5,15,7.5" Opacity="0.1" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Accent}" Margin="2.2,2.2,12.8,12.8" Opacity="0.05" />
                    </Grid>
                </Border>
            </Grid>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0"
                    Style="{StaticResource BtnGhost}" Click="OnRefreshClick"
                    ToolTip="{loc:Tr S0149}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource TextSecondary}"
                          Data="M10.4,5.6 A4.7,4.7 0 1 1 8.1,1.7 M10.4,5.6 L10.4,2.1 M10.4,5.6 L7,5.6" />
                    <TextBlock Text="{loc:Tr S0013}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- браузер создаётся/выгружается кодом: прогрузка в фоне, выгрузка в трей -->
        <Grid Grid.Row="1">
            <Grid x:Name="BrowserHost" Background="{DynamicResource InputBg}" />
            <Border x:Name="LoadingOverlay" Background="{DynamicResource InputBg}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="36" Height="36" Margin="0,0,0,16"
                          IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="LoadingRotation" />
                        </Grid.RenderTransform>
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="16,1,16,31" Opacity="1" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="26.6,5.4,5.4,26.6" Opacity="0.875" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="31,16,1,16" Opacity="0.75" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="26.6,26.6,5.4,5.4" Opacity="0.625" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="16,31,16,1" Opacity="0.5" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="5.4,26.6,26.6,5.4" Opacity="0.375" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="1,16,31,16" Opacity="0.25" />
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Accent}" Margin="5.4,5.4,26.6,26.6" Opacity="0.125" />
                    </Grid>
                    <TextBlock x:Name="LoadingMessage" MaxWidth="360" Margin="24,0"
                               Style="{DynamicResource TxtMuted}" TextAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border x:Name="ErrorOverlay" Background="{DynamicResource InputBg}" Visibility="Collapsed">
                <TextBlock x:Name="ErrorMessage" MaxWidth="420" Margin="24"
                           Style="{DynamicResource TxtMuted}" TextAlignment="Center"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
