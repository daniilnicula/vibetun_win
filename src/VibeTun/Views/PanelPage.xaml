<UserControl x:Class="VibeTun.Views.PanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- адрес + кнопка обновить -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}" Tag="https://example.com"
                     VerticalContentAlignment="Center"
                     KeyDown="OnUrlKeyDown" LostFocus="OnUrlLostFocus" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0"
                    Style="{StaticResource BtnGhost}" Click="OnRefreshClick"
                    ToolTip="Открыть адрес и обновить страницу">
                <StackPanel Orientation="Horizontal">
                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource TextSecondary}"
                          Data="M10.4,5.6 A4.7,4.7 0 1 1 8.1,1.7 M10.4,5.6 L10.4,2.1 M10.4,5.6 L7,5.6" />
                    <TextBlock Text="Обновить" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- браузер создаётся/выгружается кодом: прогрузка в фоне, выгрузка в трей -->
        <Grid x:Name="BrowserHost" Grid.Row="1" Background="{DynamicResource InputBg}" />
    </Grid>
</UserControl>
