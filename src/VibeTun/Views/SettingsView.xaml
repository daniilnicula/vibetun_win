<UserControl x:Class="VibeTun.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls">
    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{loc:Tr S0136}" Style="{StaticResource TxtH1}" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16" MaxWidth="760" HorizontalAlignment="Center">

                <!-- ==================== внешний вид и поведение ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0188}" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="{loc:Tr S0189}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ComboBox Style="{StaticResource Combo}" Width="180" HorizontalAlignment="Right"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Language}">
                                <ComboBoxItem Tag="ru" Content="{loc:Tr S0190}" />
                                <ComboBoxItem Tag="en" Content="English" />
                            </ComboBox>
                        </Grid>

                        <!-- акцент приложения следует за цветом Windows; тот же переключатель — в пикере цвета в заголовке окна -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr S0148}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource InfoHint}" ToolTip="{loc:Tr S1087}" />
                            </StackPanel>
                            <ToggleButton x:Name="SystemAccentSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UseSystemAccent}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Tr S0191}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource InputBox}" Width="100" HorizontalAlignment="Right"
                                     Text="{Binding LogLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14" />

                        <Grid>
                            <TextBlock Text="{loc:Tr S0193}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding RunAtStartup}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Tr S0194}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding StartMinimized}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr S0195}" Style="{StaticResource Txt}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="RememberStateLabel" />
                                <ContentControl Style="{StaticResource InfoHint}" ToolTip="{loc:Tr S0196}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding RememberState}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14" />

                        <Grid>
                            <TextBlock Text="{loc:Tr S0197}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AnimationSpeedLabel}" Style="{StaticResource TxtMono}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <!-- полоска в стиле прозрачности цвета: от 0.3× до 2×, шаг 0.1 -->
                        <ctl:ValueBar Minimum="0.3" Maximum="2" Step="0.1" Height="14" Margin="0,10,0,0"
                                      Value="{Binding AnimationSpeed}" ToolTip="{loc:Tr S0198}" />

                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr S0199}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource InfoHint}" ToolTip="{loc:Tr S0200}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding PreciseLatencyTest}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14" />

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr S0201}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource InfoHint}" ToolTip="{loc:Tr S0205}" />
                            </StackPanel>
                            <ComboBox Style="{StaticResource Combo}" Width="230" HorizontalAlignment="Right"
                                      SelectedValuePath="Tag" SelectedValue="{Binding CloseBehavior}">
                                <ComboBoxItem Tag="Ask" Content="{loc:Tr S0202}" />
                                <ComboBoxItem Tag="HideToTray" Content="{loc:Tr S0203}" />
                                <ComboBoxItem Tag="Exit" Content="{loc:Tr S0204}" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Tr S1052}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding RunAsAdmin}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== сеть ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S1053}" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr S1060}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                                <!-- каким заголовком User-Agent запросы подписаны прямо сейчас -->
                                <ContentControl Style="{StaticResource InfoHint}" ToolTip="{Binding PersonaUaText}" />
                            </StackPanel>
                            <ComboBox x:Name="PersonaCombo" Grid.Column="1" Style="{StaticResource Combo}" Width="200"
                                      SelectedValuePath="Tag" SelectedValue="{Binding PersonaMode}">
                                <ComboBoxItem Tag="auto" Content="{loc:Tr S1061}" />
                                <ComboBoxItem Tag="chrome" Content="{loc:Tr S1062}" />
                                <ComboBoxItem Tag="firefox" Content="{loc:Tr S1063}" />
                                <ComboBoxItem Tag="edge" Content="{loc:Tr S1064}" />
                                <!-- «честный» режим: подсказка предупреждает ещё до выбора -->
                                <ComboBoxItem Tag="app" Content="{loc:Tr S1065}" ToolTip="{Binding PersonaWarningText}" />
                            </ComboBox>
                        </Grid>

                        <!-- без маскировки заголовок называет приложение: предупреждение видно всё время, пока режим выбран -->
                        <Border x:Name="PersonaWarning" Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                                Background="{DynamicResource WarningSoft}"
                                Visibility="{Binding PersonaIsApp, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M8,1.8 L15,14 H1 Z" Stroke="{DynamicResource Warning}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M8,6.4 V9.8 M8,11.9 V12" Stroke="{DynamicResource Warning}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" FontSize="12"
                                           Text="{Binding PersonaWarningText}" Foreground="{DynamicResource Warning}" />
                            </Grid>
                        </Border>

                        <!-- Текст и кнопка стоят на одной линии: пояснение и время обновления — один абзац
                             в левой колонке (раньше это были две строки, и пустая первая сдвигала вторую
                             ниже кнопки), кнопка — в правой; оба выровнены по центру строки. -->
                        <Grid x:Name="PersonaRefreshRow" Margin="0,10,0,0"
                              Visibility="{Binding PersonaIsApp, Converter={StaticResource InvBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="{loc:Tr S1055}" /> <Run Text="{Binding PersonaAgeText, Mode=OneWay}" />
                            </TextBlock>
                            <Button Grid.Column="1" Content="{loc:Tr S1054}" Style="{StaticResource BtnGhost}"
                                    VerticalAlignment="Center" Command="{Binding RefreshPersonaCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== ядро ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0227}" Style="{StaticResource TxtH2}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CoreVersionText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Tr S0228}" Style="{StaticResource BtnGhost}" Command="{Binding CheckCoreCommand}" />
                                <Button Content="{loc:Tr S0229}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                        Command="{Binding RestoreBundledCoreCommand}" />
                                <Button Content="{loc:Tr S0230}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                        Command="{Binding InstallCoreCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CorePathText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <!-- Какая сборка запущена и откуда она: расширенная ставится из одного из двух репозиториев.
                             Строка занимает всю ширину карточки: слева от трёх кнопок ей тесно, в окне стандартного
                             размера она ломалась бы на несколько строк. Без ядра строки нет (invert: см. Converters.xaml). -->
                        <TextBlock x:Name="CoreSourceLine" Text="{Binding CoreSourceText}" Style="{StaticResource TxtMuted}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding CoreSourceText, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding CoreSupportText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding BundledCoresText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr S0231}" Style="{StaticResource Txt}" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource InfoHint}" ToolTip="{loc:Tr S0232}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding IsExtendedFlavor}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{loc:Tr S0233}" Style="{StaticResource BtnGhost}" Command="{Binding ChooseCoreFileCommand}" />
                            <Button Content="{loc:Tr S0234}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding InstallFromFileCommand}" />
                            <Button Content="{loc:Tr S0235}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="core" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== данные ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0236}" Style="{StaticResource TxtH2}" />
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{loc:Tr S0237}" />

                        <!-- место хранения: выбирается здесь, вступает в силу после перезапуска -->
                        <TextBlock Text="{loc:Tr S0238}" Style="{StaticResource TxtCaption}" Margin="0,18,0,0" />
                        <TextBlock Text="{Binding CurrentDataRootText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <RadioButton GroupName="DataStorage" Style="{StaticResource Radio}" Content="{loc:Tr S0239}"
                                     IsChecked="{Binding StorageIsLocal}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding LocalDataDirText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="25,2,0,0" />

                        <RadioButton GroupName="DataStorage" Style="{StaticResource Radio}"
                                     Content="{loc:Tr S0240}"
                                     IsChecked="{Binding StorageIsExe}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ExeDataDirText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="25,2,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="DataStorage" Style="{StaticResource Radio}" Content="{loc:Tr S0241}"
                                         IsChecked="{Binding StorageIsCustom}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Tr S0242}" Style="{StaticResource BtnGhost}"
                                    Command="{Binding ChooseCustomFolderCommand}"
                                    Visibility="{Binding IsCustomStorage, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Text="{Binding CustomDataDirText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="25,2,0,0" />

                        <TextBlock Text="{Binding StorageNoticeText}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="{Binding HasStorageNotice, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,10,0,0" Visibility="{Binding StoragePending, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StoragePendingText}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Tr S0243}" Style="{StaticResource BtnPrimary}" Margin="12,0,0,0"
                                    Command="{Binding RestartNowCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{loc:Tr S0244}" Style="{StaticResource BtnGhost}"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="root" />
                            <Button Content="{loc:Tr S0245}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="logs" />
                            <Button Content="{loc:Tr S0246}" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                    Command="{Binding ResetSettingsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== сохранённые входы ==================== -->
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0247}" Style="{StaticResource TxtH2}" />
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{loc:Tr S0248}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:Tr S0249}" Style="{StaticResource BtnDanger}" Click="OnClearPanelLogins" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{loc:Tr S0250}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
