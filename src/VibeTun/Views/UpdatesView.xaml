<UserControl x:Class="VibeTun.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- заголовок страницы -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Tr S0137}" Style="{StaticResource TxtH1}" />
                <TextBlock Text="{loc:Tr S0254}"
                           Style="{StaticResource TxtMuted}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="GitHub" Style="{StaticResource BtnGhost}" Command="{Binding OpenGitHubCommand}"
                        ToolTip="{loc:Tr S0255}" />
                <Button Content="{loc:Tr S0228}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" ToolTip="{loc:Tr S0256}" />
            </StackPanel>
        </Grid>

        <!-- основная область: слева список релизов под Windows, справа — выбранный (или текущий) релиз -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== левая колонка: релизы под Windows ==================== -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr S0257}" Style="{StaticResource TxtCaption}" Margin="2,0,0,8" />

                <ListBox Grid.Row="1" Style="{StaticResource ListPlain}"
                         ItemsSource="{Binding Releases}"
                         SelectedItem="{Binding SelectedRelease, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="7,2" CornerRadius="5"
                                            Background="{DynamicResource AccentSoft}"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Tr S0258}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding DateText}" Style="{StaticResource TxtMuted}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- состояние загрузки -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Tr S0259}" Style="{StaticResource TxtMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <!-- пустой список / ошибка -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Tr S0260}" Style="{StaticResource TxtH2}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource TxtMuted}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="{loc:Tr S0261}" Style="{StaticResource BtnPrimary}" Margin="0,12,0,0"
                                HorizontalAlignment="Center" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== правая колонка: описание релиза и кнопка ==================== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                <Grid Visibility="{Binding HasDisplayedRelease, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- шапка релиза: название сверху, под ним дата -->
                    <StackPanel Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding DisplayedRelease.Title}" Style="{StaticResource TxtH1}"
                                       FontSize="20" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                            <!-- плашка статуса выбранного релиза -->
                            <Border Grid.Column="1" Padding="9,3" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoft}"
                                    Visibility="{Binding IsCurrentDisplayed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Tr S0262}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <Border Grid.Column="1" Padding="9,3" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{DynamicResource SuccessSoft}"
                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Tr S0263}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Success}" />
                            </Border>
                            <Border Grid.Column="1" Padding="9,3" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{DynamicResource WarningSoft}"
                                    Visibility="{Binding CanRollback, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Tr S0264}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Warning}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding DisplayedRelease.DateFullText}" Style="{StaticResource TxtMuted}"
                                   Margin="0,5,0,0" />

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,12" />

                        <TextBlock Text="{loc:Tr S0265}" Style="{StaticResource TxtCaption}" Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- описание с GitHub (markdown → блоки) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DisplayedRelease.DescriptionText, Converter={StaticResource MdBlocks}}"
                                      Margin="0,0,6,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- нижняя панель: прогресс-бар скачивания и кнопка «Обновить» / «Откатить» -->
                    <StackPanel Grid.Row="2">
                        <!-- прогресс-бар скачивания -->
                        <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                                Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding DownloadStatusText}" Style="{StaticResource TxtSecondary}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadPercentText}"
                                               Style="{StaticResource TxtMono}" FontWeight="SemiBold"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{loc:Tr S0015}" Style="{StaticResource BtnSmall}"
                                            Margin="10,0,0,0" Command="{Binding CancelDownloadCommand}" />
                                </Grid>

                                <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Margin="0,9,0,0">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource UpdateProgressBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRollback}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource RollbackOrange}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                        </Border>

                        <!-- кнопки действия снизу (для текущей версии не показываются) -->
                        <Grid Margin="0,14,0,0"
                              Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{loc:Tr S0266}"
                                       Style="{StaticResource TxtMuted}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,12,0" />

                            <Button Grid.Column="1" Content="{loc:Tr S0013}" Style="{StaticResource BtnPrimary}"
                                    Padding="22,8" FontSize="13"
                                    Command="{Binding ApplyReleaseCommand}"
                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}" />

                            <Button Grid.Column="1" Content="{loc:Tr S0267}" Style="{StaticResource BtnRollback}"
                                    Padding="22,8" FontSize="13"
                                    Command="{Binding ApplyReleaseCommand}"
                                    Visibility="{Binding CanRollback, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
