<UserControl x:Class="VibeTun.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls"
             xmlns:vm="clr-namespace:VibeTun.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="ProfileItem" TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileCardStyle" TargetType="Border" BasedOn="{StaticResource HoverCard}">
            <Setter Property="BorderThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileGroupCardStyle" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderThickness" Value="1.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:ProfileItemVm}">
            <Border x:Name="ProfileCard" Style="{StaticResource ProfileCardStyle}" Padding="4,2" Margin="1,2"
                    PreviewMouseLeftButtonDown="OnDragCandidateMouseDown">
                <Grid Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{Binding AvatarBrush}"
                            VerticalAlignment="Center" Margin="6,0,0,0">
                        <Grid>
                            <Rectangle Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Fill="{Binding Protocol, Converter={StaticResource ProtoGlyph}}" />
                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Protocol, Converter={StaticResource ProtoGlyphVis}}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,1" CornerRadius="5"
                                    Background="{DynamicResource WarningSoft}"
                                    Visibility="{Binding IsTelegramOnly, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="TELEGRAM" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Warning}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,3,0,0" Style="{StaticResource TxtMuted}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="{Binding ProtocolLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Address, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{Binding Subtitle, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="{Binding PingMs, Converter={StaticResource PingText}}"
                                   Foreground="{Binding PingMs, Converter={StaticResource PingBrush}}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Right"
                                   Visibility="{Binding IsPinging, Converter={StaticResource InvBoolToVis}}" />
                        <TextBlock Text="{loc:Tr S0079}" Style="{StaticResource TxtMuted}"
                                   Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource BtnIcon}"
                                Command="{Binding DataContext.PingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{loc:Tr S0000}">
                            <Path Data="M 1,6 A 5,5 0 1 0 11,6" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3" />
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{loc:Tr S0082}">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextSecondary}"
                                  Data="M 8.9,1.4 L 10.6,3.1 L 4.1,9.6 L 1.6,10.4 L 2.4,7.9 Z" />
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{loc:Tr S0083}">
                            <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Warning}"
                                  Data="M 2.6,2.6 L 9.4,9.4 M 9.4,2.6 L 2.6,9.4" />
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{loc:Tr S0085}">
                            <Path Data="M 6,0.6 L 7.6,4.2 L 11.5,4.6 L 8.6,7.2 L 9.4,11 L 6,9 L 2.6,11 L 3.4,7.2 L 0.5,4.6 L 4.4,4.2 Z"
                                  Stretch="Uniform" Width="13" Height="13">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
                                        <Setter Property="StrokeThickness" Value="1.2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileGroupVm}">
            <Border x:Name="GroupCard" Style="{StaticResource ProfileGroupCardStyle}" Margin="1,4" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="GroupHeader" Grid.Row="0" Background="Transparent" Padding="15,0,8,0"
                            PreviewMouseLeftButtonDown="OnDragCandidateMouseDown"
                            PreviewMouseLeftButtonUp="OnGroupHeaderMouseLeftButtonUp">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:Tr S0953}" Command="{Binding RenameCommand}">
                                    <MenuItem.Icon>
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondary}"
                                              Data="M3,10.7 L9.1,4.6 L11.4,6.9 L5.3,13 L2.5,13.5 Z M8.9,4.8 L10.8,2.9 L13,5.1 L11.1,7" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Tr S0954}" Command="{Binding DissolveCommand}">
                                    <MenuItem.Icon>
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}"
                                              StrokeThickness="1.3" StrokeLineJoin="Round"
                                              Data="M1.5,4 H6 L7.5,6 H12.5 V12.5 H1.5 Z M4,9.2 H9" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{loc:Tr S0955}" Command="{Binding DeleteCommand}">
                                    <MenuItem.Icon>
                                        <Path Width="13" Height="14" Stretch="Uniform" Stroke="{DynamicResource Warning}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M2,4 H11 M4,4 V2 H9 V4 M3.2,5.5 L3.8,12.5 H9.2 L9.8,5.5 M5.4,7 V10.8 M7.6,7 V10.8" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsSubscription, Converter={StaticResource InvBoolToVis}}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20.5,7.2 A3.1,3.1 0 1 1 14.3,7.2 A3.1,3.1 0 1 1 20.5,7.2 M14.2,19.4 Q15,15 20.6,14.4"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M13,7.6 A3.6,3.6 0 1 1 5.8,7.6 A3.6,3.6 0 1 1 13,7.6 M3.2,19.6 a6.4,6.4 0 0 1 12.6,0"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVis}}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,16 A4,4 0 0 1 8,20 M4,10 A10,10 0 0 1 14,20 M4,4 A16,16 0 0 1 20,20"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="3" Canvas.Top="18" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Style="{StaticResource BtnIcon}" ToolTip="{loc:Tr S0986}"
                                    Command="{Binding RefreshSubscriptionCommand}" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVis}}">
                                <Path Data="M20,11 A8,8 0 1 0 19.5,14 M20,4 V11 H13" Width="13" Height="13"
                                      Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                            <Border Grid.Column="3" Padding="7,2" CornerRadius="9" Background="{DynamicResource SelectionBg}"
                                    VerticalAlignment="Center" Margin="0,0,5,0">
                                <TextBlock Text="{Binding ProfileCount}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Button Grid.Column="4" Style="{StaticResource BtnIcon}" ToolTip="{loc:Tr S0974}"
                                    Click="OnGroupToggleClick" VerticalAlignment="Center">
                                <Path x:Name="GroupChevron" Data="M0,0 L5,5 L10,0" Width="10" Height="5"
                                      RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>
                    </Border>
                    <ctl:SlideHost x:Name="GroupContentSlide" Grid.Row="1" Vertical="True" AnimateHeight="True"
                                   Loaded="OnGroupContentLoaded">
                        <Grid ctl:SlideHost.Key="expanded">
                            <StackPanel Margin="14,0,14,12">
                                <ItemsControl ItemsSource="{Binding VisibleProfiles}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource CardBgAlt}"
                                        Visibility="{Binding HasVisibleProfiles, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="{loc:Tr S0956}" Style="{StaticResource TxtMuted}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid ctl:SlideHost.Key="collapsed" />
                    </ctl:SlideHost>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Tr S0134}" Style="{StaticResource TxtH1}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Width="220" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Style="{StaticResource InputBox}" Tag="{loc:Tr Search}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     Height="29" Padding="10,0" Margin="10,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnGhost}" Command="{Binding CreateGroupCommand}" Height="29" Width="34"
                        Padding="0" ToolTip="{loc:Tr S0952}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="16" Height="16">
                        <Path Width="13" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Stretch="Uniform" Fill="{DynamicResource TextSecondary}"
                              Data="M1,2 H5 L6.5,4 H10 V8 H1 Z" />
                        <Path Data="M12,8 V14 M9,11 H15" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Command="{Binding PingAllCommand}" Height="29" Width="34"
                        Margin="7,0,0,0" Padding="0" ToolTip="{loc:Tr S0151}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="M1,8 H4.2 L6,3 L8.5,12.5 L10.3,8 H14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Command="{Binding ImportFileCommand}" Height="29" Width="34"
                        Margin="7,0,0,0" Padding="0" ToolTip="{loc:Tr S0152}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="M3,1.5 H9 L12.5,5 V14.5 H3 Z M9,1.5 V5 H12.5 M8,7 V11.5 M6,9.8 L8,11.8 L10,9.8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddCommand}" Height="29" Width="34"
                        Margin="7,0,0,0" Padding="0" ToolTip="{loc:Tr S0153}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="M8,2.5 V13.5 M2.5,8 H13.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="9" />
                <RowDefinition x:Name="LogRow" Height="210" MinHeight="100" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,14,0,0" PreviewMouseRightButtonDown="OnPreviewRightClick">
                <ListBox x:Name="List" Style="{StaticResource ListPlainRows}"
                         BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ProfileItem}"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}"
                         MouseDoubleClick="OnItemDoubleClick"
                         PreviewMouseWheel="OnProfilesPreviewMouseWheel"
                         PreviewMouseMove="OnCollectionPreviewMouseMove"
                         PreviewMouseLeftButtonUp="OnCollectionPreviewMouseUp"
                         LostMouseCapture="OnCollectionLostMouseCapture" Loaded="OnCollectionLoaded">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Opened="OnProfileContextMenuOpened">
                            <MenuItem Header="{loc:Tr S0952}" Command="{Binding CreateGroupCommand}" />
                            <MenuItem Header="{loc:Tr S0975}" Command="{Binding CreateSubscriptionCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr S0154}" Command="{Binding AddCommand}" />
                            <MenuItem Header="{loc:Tr S0155}">
                                <MenuItem Header="VLESS" Command="{Binding CreateManualCommand}" CommandParameter="vless" />
                                <MenuItem Header="VMess" Command="{Binding CreateManualCommand}" CommandParameter="vmess" />
                                <MenuItem Header="Trojan" Command="{Binding CreateManualCommand}" CommandParameter="trojan" />
                                <MenuItem Header="Shadowsocks" Command="{Binding CreateManualCommand}" CommandParameter="shadowsocks" />
                                <MenuItem Header="SOCKS" Command="{Binding CreateManualCommand}" CommandParameter="socks" />
                                <MenuItem Header="HTTP" Command="{Binding CreateManualCommand}" CommandParameter="http" />
                                <MenuItem Header="Hysteria 2" Command="{Binding CreateManualCommand}" CommandParameter="hysteria2" />
                                <MenuItem Header="TUIC" Command="{Binding CreateManualCommand}" CommandParameter="tuic" />
                                <MenuItem Header="WireGuard" Command="{Binding CreateManualCommand}" CommandParameter="wireguard" />
                                <MenuItem Header="AmneziaWG" Command="{Binding CreateManualCommand}" CommandParameter="amneziawg" />
                                <MenuItem Header="MTProto (Telegram)" Command="{Binding CreateManualCommand}" CommandParameter="mtproto" />
                                <MenuItem Header="{loc:Tr S0156}" Command="{Binding CreateManualCommand}" CommandParameter="tunnel" />
                            </MenuItem>
                            <MenuItem Header="{loc:Tr S0032}" Command="{Binding AddFromClipboardCommand}" />
                            <MenuItem Header="{loc:Tr S0157}" Command="{Binding ImportFileCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr S0158}" Command="{Binding ConnectCommand}" />
                            <MenuItem Header="{loc:Tr S0082}" Command="{Binding EditCommand}" />
                            <MenuItem Header="{loc:Tr S0159}" Command="{Binding DuplicateCommand}" />
                            <MenuItem Header="{loc:Tr S0160}" Command="{Binding CopyLinkCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr S0083}" Command="{Binding RemoveCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                        Background="{DynamicResource CardBg}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Opened="OnProfileContextMenuOpened">
                            <MenuItem Header="{loc:Tr S0952}" Command="{Binding CreateGroupCommand}" />
                            <MenuItem Header="{loc:Tr S0975}" Command="{Binding CreateSubscriptionCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr S0154}" Command="{Binding AddCommand}" />
                            <MenuItem Header="{loc:Tr S0032}" Command="{Binding AddFromClipboardCommand}" />
                            <MenuItem Header="{loc:Tr S0157}" Command="{Binding ImportFileCommand}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Tr S0964}" Style="{StaticResource TxtH2}" HorizontalAlignment="Center" FontSize="18" />
                        <TextBlock Text="{loc:Tr S0965}" Style="{StaticResource TxtMuted}" Margin="0,3,0,0"
                                   HorizontalAlignment="Center" FontSize="11" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="{loc:Tr S0952}" Style="{StaticResource BtnGhost}" Command="{Binding CreateGroupCommand}" />
                            <Button Content="{loc:Tr S0153}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding AddCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Background="{DynamicResource CardBgAlt}"
                        Visibility="{Binding IsSearchNoResults, Converter={StaticResource BoolToVis}}">
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Opened="OnProfileContextMenuOpened">
                            <MenuItem Header="{loc:Tr S0952}" Command="{Binding CreateGroupCommand}" />
                            <MenuItem Header="{loc:Tr S0975}" Command="{Binding CreateSubscriptionCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr S0154}" Command="{Binding AddCommand}" />
                            <MenuItem Header="{loc:Tr S0032}" Command="{Binding AddFromClipboardCommand}" />
                            <MenuItem Header="{loc:Tr S0157}" Command="{Binding ImportFileCommand}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="{loc:Tr S0966}" Style="{StaticResource TxtMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Height="3" CornerRadius="2" Margin="60,0" VerticalAlignment="Center"
                    Background="{DynamicResource BorderStrong}" IsHitTestVisible="False" />
            <GridSplitter Grid.Row="1" Height="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Background="Transparent" Cursor="SizeNS" DragCompleted="OnLogSplitterDragCompleted" />

            <Border x:Name="LogPanel" Grid.Row="2" Margin="0,0,0,14" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,8,8,6">
                        <TextBlock Text="{loc:Tr S0022}" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Tr S0074}" Style="{StaticResource BtnSmall}" Click="OnLogCopyClick" />
                            <Button Content="{loc:Tr S0034}" Style="{StaticResource BtnSmall}" Margin="6,0,0,0"
                                    Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="8,0,8,8" ClipToBounds="True">
                        <ScrollViewer x:Name="LogScroll" Padding="6,4"
                                      Background="Transparent" Focusable="False"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding Log.Lines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Loaded="OnLogLineLoaded">
                                            <ctl:LogLineText Segments="{Binding Segments}" Style="{StaticResource TxtMono}"
                                                             TextWrapping="NoWrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Height="24" VerticalAlignment="Top" Background="{DynamicResource CardBg}"
                                IsHitTestVisible="False" Panel.ZIndex="1">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
