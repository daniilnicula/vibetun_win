<UserControl x:Class="VibeTun.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:VibeTun.Views"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls"
             x:Name="Root">
    <!-- активный профиль — тонкая рамка Accent вокруг строки; при смене профиля рамка переезжает
         от прежней строки к новой (ProfilesView.xaml.cs). Наведение мышью и выбор кликом строку не подсвечивают (ПКМ выделяет строку для меню). -->
    <UserControl.Resources>
        <Style x:Key="ProfileItem" TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="hl" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="hl" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- заголовок и действия -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Профили" Style="{StaticResource TxtH1}" />
            </StackPanel>

            <TextBox Grid.Column="1" Width="210" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Style="{StaticResource InputBox}" Tag="Поиск"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Height="27" Padding="10,0,10,0" Margin="10,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top" Height="27">
                <Button Style="{StaticResource BtnGhost}" Command="{Binding PingAllCommand}" Height="27" Width="34"
                        Padding="0" ToolTip="Пинг всех профилей"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="M1,8 H4.2 L6,3 L8.5,12.5 L10.3,8 H14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Command="{Binding ImportFileCommand}" Height="27" Width="34"
                        Margin="8,0,0,0" Padding="0" ToolTip="Импорт из файла"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="M3,1.5 H9 L12.5,5 V14.5 H3 Z M9,1.5 V5 H12.5 M8,7 V11.5 M6,9.8 L8,11.8 L10,9.8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddCommand}" Height="27" Width="34"
                        Margin="8,0,0,0" Padding="0" ToolTip="Добавить профиль"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="M8,2.5 V13.5 M2.5,8 H13.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- содержимое: строка 1 — профили, строка 2 — логи; между ними разделитель GridSplitter -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <!-- строка разделителя: GridSplitter меняет высоту строк над ним и под ним -->
                <RowDefinition Height="9" />
                <RowDefinition x:Name="LogRow" Height="210" MinHeight="100" />
            </Grid.RowDefinitions>

            <ListBox x:Name="List" Grid.Row="0" Margin="0,14,0,0" Style="{StaticResource ListPlainRows}" BorderThickness="0"
                     Background="Transparent" ItemContainerStyle="{StaticResource ProfileItem}"
                     ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                     MouseDoubleClick="OnItemDoubleClick"
                     PreviewMouseRightButtonDown="OnPreviewRightClick">

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Добавить профиль…" Command="{Binding AddCommand}" />
                        <MenuItem Header="Создать вручную">
                            <MenuItem Header="VLESS" Command="{Binding CreateManualCommand}" CommandParameter="vless" />
                            <MenuItem Header="VMess" Command="{Binding CreateManualCommand}" CommandParameter="vmess" />
                            <MenuItem Header="Trojan" Command="{Binding CreateManualCommand}" CommandParameter="trojan" />
                            <MenuItem Header="Shadowsocks" Command="{Binding CreateManualCommand}" CommandParameter="shadowsocks" />
                            <MenuItem Header="SOCKS" Command="{Binding CreateManualCommand}" CommandParameter="socks" />
                            <MenuItem Header="HTTP" Command="{Binding CreateManualCommand}" CommandParameter="http" />
                            <MenuItem Header="Hysteria 2" Command="{Binding CreateManualCommand}" CommandParameter="hysteria2" />
                            <MenuItem Header="TUIC" Command="{Binding CreateManualCommand}" CommandParameter="tuic" />
                            <MenuItem Header="WireGuard" Command="{Binding CreateManualCommand}" CommandParameter="wireguard" />
                            <MenuItem Header="AmneziaWG" Command="{Binding CreateManualCommand}" CommandParameter="amneziawg" />
                            <MenuItem Header="MTProto (Telegram)" Command="{Binding CreateManualCommand}" CommandParameter="mtproto" />
                            <MenuItem Header="Custom (JSON ядра)" Command="{Binding CreateManualCommand}" CommandParameter="tunnel" />
                        </MenuItem>
                        <MenuItem Header="Вставить из буфера" Command="{Binding AddFromClipboardCommand}" />
                        <MenuItem Header="Импорт из файла…" Command="{Binding ImportFileCommand}" />
                        <Separator />
                        <MenuItem Header="Подключиться" Command="{Binding ConnectCommand}" />
                        <MenuItem Header="Редактировать" Command="{Binding EditCommand}" />
                        <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" />
                        <MenuItem Header="Скопировать конфиг" Command="{Binding CopyLinkCommand}" />
                        <Separator />
                        <MenuItem Header="Удалить" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- аватар с протоколом -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{Binding AvatarBrush}"
                                    VerticalAlignment="Center" Margin="14,0,0,0">
                                <Grid>
                                    <Rectangle Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Fill="{Binding Protocol, Converter={StaticResource ProtoGlyph}}" />
                                    <!-- буквенный бейдж — для протоколов без глифа (socks, ssh, anytls…) -->
                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Protocol, Converter={StaticResource ProtoGlyphVis}}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- строка 1: имя обрезается многоточием, бейджи справа всегда видны -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Grid.Column="2" Margin="8,0,0,0" Padding="6,1" CornerRadius="5"
                                            Background="{DynamicResource WarningSoft}"
                                            Visibility="{Binding IsTelegramOnly, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="TELEGRAM" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Warning}" />
                                    </Border>
                                </Grid>

                                <!-- строка 2: одна строка текста; длинный адрес обрезается внутри колонки -->
                                <TextBlock Grid.Row="1" Margin="0,3,0,0" Style="{StaticResource TxtMuted}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding ProtocolLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Address, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Subtitle, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>

                            <!-- задержка -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="{Binding PingMs, Converter={StaticResource PingText}}"
                                           Foreground="{Binding PingMs, Converter={StaticResource PingBrush}}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding IsPinging, Converter={StaticResource InvBoolToVis}}" />
                                <TextBlock Text="измерение…" Style="{StaticResource TxtMuted}"
                                           Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Button Style="{StaticResource BtnIcon}"
                                        Command="{Binding DataContext.PingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Проверить задержку">
                                    <Path Data="M 1,6 A 5,5 0 1 0 11,6" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3" />
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Редактировать">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondary}"
                                          Data="M 8.9,1.4 L 10.6,3.1 L 4.1,9.6 L 1.6,10.4 L 2.4,7.9 Z" />
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Удалить">
                                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{DynamicResource Warning}"
                                          Data="M 2.6,2.6 L 9.4,9.4 M 9.4,2.6 L 2.6,9.4" />
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="В избранное">
                                    <Path Data="M 6,0.6 L 7.6,4.2 L 11.5,4.6 L 8.6,7.2 L 9.4,11 L 6,9 L 2.6,11 L 3.4,7.2 L 0.5,4.6 L 4.4,4.2 Z"
                                          Stretch="Uniform" Width="13" Height="13">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
                                                <Setter Property="StrokeThickness" Value="1.2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="0" Margin="0,14,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                    Background="Transparent" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="There is empty" Style="{StaticResource TxtH2}" HorizontalAlignment="Center" FontSize="18" />
                    <TextBlock Text="(Ctrl + V) or add it manualy"
                               Style="{StaticResource TxtMuted}" Margin="0,-1,0,0" HorizontalAlignment="Center" FontSize="10" ScrollViewer.CanContentScroll="True" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="From buffer" Style="{StaticResource BtnPrimary}" Command="{Binding AddFromClipboardCommand}" />
                        <Button Content="Add manualy" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding AddCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- разделитель: тянем вверх-вниз, меняя высоту панели логов -->
            <Border Grid.Row="1" Height="3" CornerRadius="2" Margin="60,0" VerticalAlignment="Center"
                    Background="{DynamicResource BorderStrong}" IsHitTestVisible="False" />
            <GridSplitter Grid.Row="1" Height="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Background="Transparent" Cursor="SizeNS" DragCompleted="OnLogSplitterDragCompleted" />

            <!-- панель логов: журнал приложения и ядра, последние строки -->
            <Border x:Name="LogPanel" Grid.Row="2" Margin="0,0,0,14" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,8,8,6">
                        <TextBlock Text="Логи" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Копировать" Style="{StaticResource BtnSmall}" Click="OnLogCopyClick" />
                            <Button Content="Очистить" Style="{StaticResource BtnSmall}" Margin="6,0,0,0"
                                    Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- строки журнала: ключевые данные цветом акцента; новая строка выезжает слева и проявляется -->
                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" Margin="8,0,8,8" Padding="6,4"
                                  Background="Transparent" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Log.Lines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Loaded="OnLogLineLoaded">
                                        <ctl:LogLineText Segments="{Binding Segments}" Style="{StaticResource TxtMono}"
                                                         TextWrapping="NoWrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
