<UserControl x:Class="VibeTun.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>

        <!-- строка-кнопка без собственного оформления: вид задаёт карточка внутри -->
        <Style x:Key="DnsRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="content" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- карточка строки: выбранный DNS — в цвет акцента, как активный профиль и открытая вкладка -->
        <Style x:Key="DnsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- провайдер с выбранным сервером: акцентная рамка, а заливка — только у самого сервера внутри -->
        <Style x:Key="DnsEntryCard" TargetType="Border" BasedOn="{StaticResource DnsCard}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsProvider}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource CardBg}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DnsName" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- плитка со значком строки -->
        <Style x:Key="DnsTile" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardBgAlt}" />
        </Style>

        <!-- избранное выделяется тёплой плиткой — в цвет звезды -->
        <Style x:Key="DnsEntryTile" TargetType="Border" BasedOn="{StaticResource DnsTile}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DnsGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DnsEntryGlyph" TargetType="Path" BasedOn="{StaticResource DnsGlyph}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- сервер провайдера: строка с кружком выбора, как переключатели в настройках -->
        <Style x:Key="DnsServerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource CardBgAlt}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= «Системный» и «Через Proxy» ======================= -->
        <DataTemplate x:Key="PinnedTemplate">
            <Button Style="{StaticResource DnsRowButton}"
                    Command="{Binding DataContext.SelectPinnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ToolTip>
                    <TextBlock Text="{Binding Hint}" MaxWidth="340" TextWrapping="Wrap" />
                </Button.ToolTip>
                <Border Style="{StaticResource DnsCard}">
                    <Grid Height="58" Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DnsTile}">
                            <Grid>
                                <!-- системный: монитор -->
                                <Viewbox Width="18" Height="18"
                                         Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource DnsGlyph}"
                                              Data="M4.5,4.5 H19.5 A2,2 0 0 1 21.5,6.5 V14.5 A2,2 0 0 1 19.5,16.5 H4.5 A2,2 0 0 1 2.5,14.5 V6.5 A2,2 0 0 1 4.5,4.5 Z M12,16.5 V20 M8.5,20 H15.5" />
                                    </Canvas>
                                </Viewbox>
                                <!-- через proxy: щит -->
                                <Viewbox Width="18" Height="18"
                                         Visibility="{Binding IsSystem, Converter={StaticResource InvBoolToVis}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource DnsGlyph}"
                                              Data="M12,3 L19.5,5.8 V11.4 C19.5,15.9 16.4,19.5 12,21 C7.6,19.5 4.5,15.9 4.5,11.4 V5.8 Z M8.8,12 L11.1,14.3 L15.3,9.9" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DnsName}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TxtMuted}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- ======================= пинг ======================= -->
        <!-- время ответа в цвет задержки, как у профилей; «нет ответа» — причина в подсказке.
             Одинаково у сервера провайдера и у строки списка (там — лучший из серверов) -->
        <DataTemplate x:Key="PingCell">
            <Grid>
                <TextBlock Text="{Binding PingMs, Converter={StaticResource PingText}}"
                           Foreground="{Binding PingMs, Converter={StaticResource PingBrush}}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Right"
                           ToolTip="{Binding PingTip}"
                           Visibility="{Binding ShowPingValue, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="нет ответа" FontSize="12" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right"
                           ToolTip="{Binding PingTip}"
                           Visibility="{Binding PingFailed, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="измерение…" Style="{StaticResource TxtMuted}" HorizontalAlignment="Right"
                           Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- ======================= сервер провайдера ======================= -->
        <DataTemplate x:Key="ServerTemplate">
            <Button Style="{StaticResource DnsServerButton}" ToolTip="Использовать этот DNS-сервер"
                    Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="15" Height="15" Margin="11,0,0,0" VerticalAlignment="Center">
                        <Ellipse StrokeThickness="1.4" Fill="{DynamicResource InputBg}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{DynamicResource InputBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}"
                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- ширина под самый длинный IPv4: подписи вариантов встают ровной колонкой -->
                    <TextBlock Grid.Column="1" Text="{Binding Address}" MinWidth="124" Margin="11,0,10,0" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- вариант сервера (режим фильтрации, регион выхода) или почему строка устарела -->
                    <TextBlock Grid.Column="2" Text="{Binding Note}" Margin="0,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TxtMuted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource PingCell}"
                                      Margin="0,0,12,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ======================= провайдер или свой DNS ======================= -->
        <DataTemplate x:Key="EntryTemplate">
            <Border Style="{StaticResource DnsEntryCard}">
                <StackPanel>
                    <!-- шапка: нажатие раскрывает провайдера или выбирает свой DNS; за неё же строку
                         перетаскивают (жесты — в DnsView.xaml.cs) -->
                    <Grid x:Name="EntryHeader" Height="58" Background="Transparent" Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ручка перетаскивания: ярче при наведении на строку -->
                        <Border Grid.Column="0" Background="Transparent" Cursor="SizeNS"
                                ToolTip="Перетащите, чтобы изменить порядок">
                            <Path Width="8" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource TextMuted}"
                                  Data="M1.5,0.8 A1.2,1.2 0 1 1 1.5,3.2 A1.2,1.2 0 1 1 1.5,0.8 Z M6.5,0.8 A1.2,1.2 0 1 1 6.5,3.2 A1.2,1.2 0 1 1 6.5,0.8 Z M1.5,5.8 A1.2,1.2 0 1 1 1.5,8.2 A1.2,1.2 0 1 1 1.5,5.8 Z M6.5,5.8 A1.2,1.2 0 1 1 6.5,8.2 A1.2,1.2 0 1 1 6.5,5.8 Z M1.5,10.8 A1.2,1.2 0 1 1 1.5,13.2 A1.2,1.2 0 1 1 1.5,10.8 Z M6.5,10.8 A1.2,1.2 0 1 1 6.5,13.2 A1.2,1.2 0 1 1 6.5,10.8 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=EntryHeader}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DnsEntryTile}">
                            <Grid>
                                <!-- провайдер: глобус -->
                                <Viewbox Width="18" Height="18"
                                         Visibility="{Binding IsProvider, Converter={StaticResource BoolToVis}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource DnsEntryGlyph}"
                                              Data="M20.6,12 A8.6,8.6 0 1 1 3.4,12 A8.6,8.6 0 1 1 20.6,12 M12,3.6 A3.9,8.4 0 1 1 12,20.4 A3.9,8.4 0 1 1 12,3.6 M3.6,12 H20.4" />
                                    </Canvas>
                                </Viewbox>
                                <!-- свой DNS: сервер -->
                                <Viewbox Width="18" Height="18"
                                         Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource DnsEntryGlyph}"
                                              Data="M5.5,4 H18.5 A2,2 0 0 1 20.5,6 V9 A2,2 0 0 1 18.5,11 H5.5 A2,2 0 0 1 3.5,9 V6 A2,2 0 0 1 5.5,4 Z M5.5,13 H18.5 A2,2 0 0 1 20.5,15 V18 A2,2 0 0 1 18.5,20 H5.5 A2,2 0 0 1 3.5,18 V15 A2,2 0 0 1 5.5,13 Z M7.4,7.5 H7.5 M7.4,16.5 H7.5 M11,7.5 H16.5 M11,16.5 H16.5" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DnsName}" />
                            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Subtitle, Mode=OneWay}" /><Run Text="{Binding SelectedNote, Mode=OneWay}" Foreground="{DynamicResource Accent}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- пинг: у своего DNS — время ответа, у провайдера — лучший из его серверов -->
                        <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource PingCell}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />

                        <!-- справа, как у профилей: правка и удаление (только свои DNS), раскрытие (провайдеры), звезда -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Style="{StaticResource BtnIcon}" ToolTip="Редактировать"
                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"
                                      Data="M 8.9,1.4 L 10.6,3.1 L 4.1,9.6 L 1.6,10.4 L 2.4,7.9 Z" />
                            </Button>
                            <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="Удалить"
                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource Warning}"
                                      Data="M 2.6,2.6 L 9.4,9.4 M 9.4,2.6 L 2.6,9.4" />
                            </Button>
                            <Button Style="{StaticResource BtnIcon}" ToolTip="Серверы провайдера"
                                    Visibility="{Binding IsProvider, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Path Data="M0,0 L5,5 L10,0" Width="10" Height="5" RenderTransformOrigin="0.5,0.5"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="В избранное"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Path Data="M 6,0.6 L 7.6,4.2 L 11.5,4.6 L 8.6,7.2 L 9.4,11 L 6,9 L 2.6,11 L 3.4,7.2 L 0.5,4.6 L 4.4,4.2 Z"
                                      Stretch="Uniform" Width="13" Height="13">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
                                            <Setter Property="StrokeThickness" Value="1.2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- серверы раскрытого провайдера -->
                    <StackPanel Margin="68,0,14,12" Visibility="{Binding ShowServers, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding Description, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />

                        <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource ServerTemplate}" />

                        <Border Padding="12,9" CornerRadius="8" Background="{DynamicResource CardBgAlt}" Margin="0,0,0,4"
                                Visibility="{Binding NoServers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                       Text="Адресов серверов пока нет — нажмите «Обновить», чтобы спросить их у провайдера." />
                        </Border>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TxtMuted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button Content="Сайт" Style="{StaticResource BtnGhost}" Padding="10,4" FontSize="12"
                                        ToolTip="{Binding Site}"
                                        Visibility="{Binding HasSite, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="{Binding RefreshText}" Style="{StaticResource BtnGhost}" Padding="10,4" FontSize="12"
                                        Margin="6,0,0,0" ToolTip="Ещё раз спросить у провайдера адреса его серверов"
                                        Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}"
                                        Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ======================= домены и приложения со своим DNS ======================= -->
        <!-- карточка записи: после выбора DNS раздел возвращается во вкладку записи, и карточка
             ненадолго подсвечена акцентом — видно, кому достался DNS -->
        <Style x:Key="TargetCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,8,10,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DNS записи — под её строкой, во всю ширину карточки: «DNS не выбран» и «Выбрать DNS» или
             выбранный DNS и «Изменить». Обе кнопки открывают «Основные», где DNS и выбирают -->
        <DataTemplate x:Key="ChoiceRowTemplate">
            <Border Padding="10,0,4,0" MinHeight="36" CornerRadius="8" Background="{DynamicResource CardBgAlt}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- DNS ещё не выбран -->
                    <TextBlock Style="{StaticResource TxtMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="DNS не выбран" ToolTip="Пока DNS не выбран, работает основной"
                               Visibility="{Binding HasDns, Converter={StaticResource InvBoolToVis}}" />
                    <Button Grid.Column="1" Content="Выбрать DNS" Style="{StaticResource BtnPrimary}"
                            Padding="10,4" FontSize="12" Margin="8,4,0,4" VerticalAlignment="Center"
                            ToolTip="Откроются «Основные» — нажмите там на DNS"
                            Visibility="{Binding HasDns, Converter={StaticResource InvBoolToVis}}"
                            Command="{Binding DataContext.PickDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <!-- выбран -->
                    <TextBlock Style="{StaticResource Txt}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6"
                               Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}">
                        <TextBlock.ToolTip>
                            <StackPanel MaxWidth="340">
                                <TextBlock Text="{Binding DnsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DnsHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DnsHint, Converter={StaticResource NotNullToVis}}" />
                            </StackPanel>
                        </TextBlock.ToolTip>
                        <Run Text="DNS:" Foreground="{DynamicResource TextMuted}" /> <Run Text="{Binding DnsText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="Изменить" Style="{StaticResource BtnGhost}"
                            Padding="10,4" FontSize="12" Margin="8,4,0,4" VerticalAlignment="Center"
                            ToolTip="Выбрать другой DNS в «Основных»"
                            Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.PickDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- глобус — значок домена (тот же, что у провайдеров) -->
        <Geometry x:Key="GlobeGeometry">M20.6,12 A8.6,8.6 0 1 1 3.4,12 A8.6,8.6 0 1 1 20.6,12 M12,3.6 A3.9,8.4 0 1 1 12,20.4 A3.9,8.4 0 1 1 12,3.6 M3.6,12 H20.4</Geometry>

        <!-- окно — значок приложения, у которого значок из .exe не извлёкся -->
        <Geometry x:Key="WindowGeometry">M4.5,4.5 H19.5 A2,2 0 0 1 21.5,6.5 V17.5 A2,2 0 0 1 19.5,19.5 H4.5 A2,2 0 0 1 2.5,17.5 V6.5 A2,2 0 0 1 4.5,4.5 Z M2.5,9 H21.5</Geometry>

        <!-- ======================= домен со своим DNS ======================= -->
        <!-- как правило во вкладке «Домены и IP» маршрутизации: галочка, запись (правится прямо здесь),
             тип и крестик; ниже — DNS записи -->
        <DataTemplate x:Key="DomainTemplate">
            <Border Style="{StaticResource TargetCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled}" ToolTip="Свой DNS для домена включён" />

                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Margin="10,0,0,0"
                                Background="{DynamicResource CardBgAlt}">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource GlobeGeometry}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding Pattern, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Запись можно поправить прямо здесь" />

                        <TextBlock Grid.Column="3" Text="{Binding KindLabel}" MinWidth="44" Margin="10,0,0,0"
                                   VerticalAlignment="Center" ToolTip="{Binding MatchHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TxtMuted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.RemoveDomainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="Убрать домен">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" />
                        </Button>
                    </Grid>

                    <!-- запись с ошибкой (IP, неверный regex): правило в ядро не уходит -->
                    <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Warning}" FontSize="12" TextWrapping="Wrap"
                               Margin="67,6,0,0"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />

                    <ContentPresenter Margin="35,8,0,0" Content="{Binding}" ContentTemplate="{StaticResource ChoiceRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ======================= приложение со своим DNS ======================= -->
        <!-- как карточка приложения в маршрутизации; ниже — DNS приложения -->
        <DataTemplate x:Key="AppTemplate">
            <Border Style="{StaticResource TargetCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled}" ToolTip="Свой DNS для приложения включён" />

                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Margin="10,0,0,0"
                                Background="{DynamicResource CardBgAlt}">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                                <!-- значок не извлёкся (файла уже нет) — общий значок окна -->
                                <Viewbox Width="16" Height="16"
                                         Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource WindowGeometry}"
                                              Stroke="{DynamicResource TextMuted}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding Path}" Style="{StaticResource TxtMuted}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}" />
                        </StackPanel>

                        <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="Убрать приложение">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" />
                        </Button>
                    </Grid>

                    <ContentPresenter Margin="35,8,0,0" Content="{Binding}" ContentTemplate="{StaticResource ChoiceRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- заголовок по центру — как в «Настройках» -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="DNS" Style="{StaticResource TxtH1}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- переключатель вкладок — как в «Маршрутизации»: одна вкладка всегда выбрана -->
        <Border Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" Padding="3" CornerRadius="10"
                Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Grid ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="8">
                <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource TabToggle}" Content="Основные" IsChecked="{Binding IsMainTab}" />
                <ToggleButton Style="{StaticResource TabToggle}" Content="Домены" Margin="3,0,0,0"
                              IsChecked="{Binding IsDomainsTab}" />
                <ToggleButton Style="{StaticResource TabToggle}" Content="Приложения" Margin="3,0,0,0"
                              IsChecked="{Binding IsAppsTab}" />
            </StackPanel>
            </Grid>
        </Border>

        <!-- выбирают DNS для домена или приложения: следующее нажатие в «Основных» достанется ему,
             и раздел вернётся во вкладку записи -->
        <Border Grid.Row="2" MaxWidth="760" Margin="0,14,0,0" Padding="12,9" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource CardBg}" VerticalAlignment="Center">
                    <Grid>
                        <Image Source="{Binding PickingIcon}" Width="20" Height="20" Stretch="Uniform"
                               Visibility="{Binding PickingKind, Converter={StaticResource TabVis}, ConverterParameter=icon}" />
                        <Viewbox Width="16" Height="16"
                                 Visibility="{Binding PickingKind, Converter={StaticResource TabVis}, ConverterParameter=app}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource WindowGeometry}" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox Width="16" Height="16"
                                 Visibility="{Binding PickingKind, Converter={StaticResource TabVis}, ConverterParameter=domain}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource GlobeGeometry}" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PickingTitle}" Style="{StaticResource Txt}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PickingHint}" Style="{StaticResource TxtMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" Content="Отмена" Style="{StaticResource BtnGhost}" Padding="10,4" FontSize="12"
                        VerticalAlignment="Center" ToolTip="Не менять DNS и вернуться (Esc)"
                        Command="{Binding CancelPickCommand}" />
            </Grid>
        </Border>

        <!-- вкладки: по центру, шириной не больше 760 — как «Настройки» -->
        <ctl:SlideHost Grid.Row="3" Margin="0,14,0,0" SelectedKey="{Binding Tab}">

            <!-- ============================== Основные ============================== -->
            <ScrollViewer ctl:SlideHost.Key="main" x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="0,0,0,16">
                    <!-- заголовок вкладки, пинг и «Добавить свой» -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Основные" Style="{StaticResource TxtH2}" />
                            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="DNS для всех: через него ядро узнаёт адреса сайтов, если у домена или приложения нет своего. Выбор сохраняется и применяется сразу: активное подключение перезапускается автоматически." />
                            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="Сейчас:" /> <Run Text="{Binding SelectionText, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" /><Run Text="{Binding RulesSummaryText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top" Height="27">
                            <!-- пинг всех серверов — та же кнопка, что «Пинг всех профилей» -->
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding PingAllCommand}" Height="27" Width="34"
                                    Padding="0" ToolTip="Пинг всех DNS-серверов"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Path Width="15" Height="15" Stretch="Uniform" Data="M1,8 H4.2 L6,3 L8.5,12.5 L10.3,8 H14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddCustomCommand}"
                                    Height="27" Padding="10,0,12,0" Margin="8,0,0,0"
                                    ToolTip="Добавить свой DNS-сервер: IP-адрес и название">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11" Height="11" Stretch="Uniform" Data="M8,2.5 V13.5 M2.5,8 H13.5" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock Text="Добавить свой" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- всегда наверху, не перетаскиваются -->
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Pinned}" ItemTemplate="{StaticResource PinnedTemplate}" />

                    <Grid Margin="2,8,2,8">
                        <TextBlock Text="Провайдеры и свои DNS" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" />
                        <TextBlock Text="порядок меняется перетаскиванием" Style="{StaticResource TxtMuted}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}"
                                  PreviewMouseLeftButtonDown="OnEntryPreviewMouseDown"
                                  PreviewMouseMove="OnEntryPreviewMouseMove"
                                  PreviewMouseLeftButtonUp="OnEntryPreviewMouseUp"
                                  LostMouseCapture="OnEntryLostCapture" />

                    <!-- ======================= DNS обхода DPI ======================= -->
                    <!-- раньше было в «Настройках» → «Обход DPI»: движок обхода резолвит сам, без ядра -->
                    <TextBlock Text="Обход DPI" Style="{StaticResource TxtCaption}" Margin="2,8,2,8" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid MinHeight="58" Margin="22,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- молния: обход DPI -->
                                <Border Style="{StaticResource DnsTile}">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M13,2 L3,14 H12 L11,22 L21,10 H12 Z"
                                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Откуда брать адреса" Style="{StaticResource Txt}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Движок обхода узнаёт адреса сайтов сам, без ядра" Style="{StaticResource TxtMuted}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" Style="{StaticResource Combo}" Width="230" VerticalAlignment="Center"
                                          SelectedValuePath="Tag" SelectedValue="{Binding DpiDoh}">
                                    <ComboBoxItem Content="Системный DNS провайдера" Tag="Off" />
                                    <ComboBoxItem Content="DoH: Cloudflare" Tag="Cloudflare" />
                                    <ComboBoxItem Content="DoH: Google" Tag="Google" />
                                    <ComboBoxItem Content="DoH: свой URL" Tag="Custom" />
                                </ComboBox>
                            </Grid>

                            <StackPanel Margin="68,0,14,14">
                                <TextBox Style="{StaticResource InputBox}" Margin="0,0,0,8" Tag="https://cloudflare-dns.com/dns-query"
                                         ToolTip="DoH-сервер с JSON-ответом (application/dns-json), как у Cloudflare и Google"
                                         Text="{Binding DpiDohUrl}"
                                         Visibility="{Binding DpiDohIsCustom, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                           Text="Провайдерский DNS часто подменяет адреса заблокированных сайтов и отдаёт адрес заглушки. DoH идёт поверх HTTPS: провайдер запроса не видит и подменить ответ не может. Выбор действует, когда обход идёт «Напрямую»; «Через профиль» адреса узнаёт ядро — по DNS, выбранному выше. Совпадают ли адреса от DoH и от системного DNS, видно в «Диагностике» на вкладке «DPI bypass»." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== Домены ============================== -->
            <ScrollViewer ctl:SlideHost.Key="domains" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="0,0,0,16">
                    <TextBlock Text="Домены" Style="{StaticResource TxtH2}" />
                    <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,10" TextWrapping="Wrap"
                               Text="Свой DNS для отдельных сайтов: запросы адресов этих доменов и прямые подключения к ним идут через выбранный DNS вместо основного. Запись — домен (youtube.com, .ru, *.example.org) или regex (youtube, regex:^ads\.); можно несколько через запятую." />

                    <!-- добавление записи — как во вкладке «Домены и IP» маршрутизации -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Style="{StaticResource InputBox}" Tag="youtube.com, .ru, regex:^ads\."
                                 Text="{Binding NewDomainPattern, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddDomainCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="1" Text="{Binding NewDomainKindLabel}" MinWidth="58" Margin="8,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TxtMuted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNewDomainProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="2" Content="Добавить" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                Command="{Binding AddDomainCommand}" />
                    </Grid>

                    <!-- введён IP или regex с ошибкой — почему «Добавить» недоступна -->
                    <TextBlock Text="{Binding NewDomainProblem}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                               Margin="2,6,0,0"
                               Visibility="{Binding HasNewDomainProblem, Converter={StaticResource BoolToVis}}" />

                    <!-- доменов ещё нет — как пользоваться -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0"
                            Visibility="{Binding HasDomains, Converter={StaticResource InvBoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource DnsTile}" VerticalAlignment="Top">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource GlobeGeometry}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Свой DNS для сайта" Style="{StaticResource Txt}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Введите домен выше и нажмите «Добавить». Под записью нажмите «Выбрать DNS» — откроются «Основные»: нажмите там на DNS, и вы вернётесь сюда. Остальные сайты продолжат работать через основной." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Domains}" ItemTemplate="{StaticResource DomainTemplate}" />

                    <!-- какая запись важнее и где свой DNS действует -->
                    <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="2,6,2,0"
                               Text="Если сайт подходит под несколько записей, действует более точная: music.youtube.com важнее youtube.com, домен важнее regex. Записи доменов важнее записей приложений. Свой DNS действует там же, где основной: в запросах адресов через ядро (в TUN-режиме — у всех программ) и в прямых подключениях; через прокси адрес сайта по-прежнему узнаёт сервер прокси." />
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== Приложения ============================== -->
            <ScrollViewer ctl:SlideHost.Key="apps" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="0,0,0,16">
                    <!-- как во вкладке «Приложения» маршрутизации -->
                    <Grid>
                        <TextBlock Text="Приложения" Style="{StaticResource TxtH2}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="27">
                            <Button Content="Добавить .exe" Style="{StaticResource BtnGhost}" Height="27" Padding="10,0"
                                    ToolTip="Выбрать .exe файл приложения"
                                    Command="{Binding AddAppFromExeCommand}" />
                            <Button Content="Из процессов" Style="{StaticResource BtnPrimary}" Height="27" Padding="10,0"
                                    Margin="6,0,0,0" ToolTip="Выбрать среди запущенных приложений"
                                    Command="{Binding AddAppsFromProcessesCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,10" TextWrapping="Wrap"
                               Text="Свой DNS для отдельных программ: их запросы адресов и прямые подключения идут через выбранный DNS вместо основного." />

                    <!-- приложений ещё нет — как пользоваться -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,2,0,6"
                            Visibility="{Binding HasApps, Converter={StaticResource InvBoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource DnsTile}" VerticalAlignment="Top">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource WindowGeometry}"
                                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Свой DNS для приложения" Style="{StaticResource Txt}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Добавьте приложение — «Добавить .exe» или «Из процессов». Под ним нажмите «Выбрать DNS» — откроются «Основные»: нажмите там на DNS, и вы вернётесь сюда. Остальные приложения продолжат работать через основной." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTemplate}" />

                    <!-- где свой DNS действует, а где нет -->
                    <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="2,6,2,0"
                               Text="DNS приложения заменяет основной там же, где работает основной: в DNS-запросах самого приложения и в его прямых подключениях. В TUN-режиме многие программы спрашивают адреса через службу DNS Windows (svchost.exe) — для них остаётся основной DNS. Если сайт есть во вкладке «Домены», действует его запись." />
                </StackPanel>
            </ScrollViewer>
        </ctl:SlideHost>
    </Grid>
</UserControl>
