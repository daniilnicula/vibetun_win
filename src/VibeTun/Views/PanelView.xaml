<UserControl x:Class="VibeTun.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services">
    <Grid Margin="18,14,18,14">
        <TextBlock x:Name="EmptyHint"
                   Text="{loc:Tr S0150}"
                   Style="{StaticResource TxtMuted}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <!-- страница выбранной панели (браузер) подставляется кодом -->
        <ContentControl x:Name="Host" />
    </Grid>
</UserControl>
