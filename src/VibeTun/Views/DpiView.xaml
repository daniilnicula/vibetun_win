<UserControl x:Class="VibeTun.Views.DpiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services">
    <UserControl.Resources>

        <!-- строка-кнопка без собственного оформления: вид задаёт карточка внутри -->
        <Style x:Key="DpiRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="content" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- карточка сервиса: активная (включённая) — в цвет акцента, как включённый профиль;
             выделения «открытого сейчас» сервиса нет: после правки оно оставалось и путало -->
        <Style x:Key="DpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                </Trigger>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DpiName" TargetType="TextBlock" BasedOn="{StaticResource Txt}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- плитка со значком сервиса: та же иконка, что браузер показывает у адреса страницы -->
        <Style x:Key="DpiTile" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardBgAlt}" />
        </Style>

        <!-- глобус — общий значок, пока значок сайта не скачался -->
        <Geometry x:Key="DpiGlobeGeometry">M20.6,12 A8.6,8.6 0 1 1 3.4,12 A8.6,8.6 0 1 1 20.6,12 M12,3.6 A3.9,8.4 0 1 1 12,20.4 A3.9,8.4 0 1 1 12,3.6 M3.6,12 H20.4</Geometry>

        <!-- ======================= пинг ======================= -->
        <!-- время ответа сервера в цвет задержки, как у профилей и DNS; «нет ответа» — причина в подсказке.
             Нажатие повторяет замер: тот же жест, что «Пинг» у профиля -->
        <DataTemplate x:Key="PingCell">
            <Button Style="{StaticResource DpiRowButton}" Padding="4,2" ToolTip="{loc:Tr dpi.pingOne}"
                    Command="{Binding DataContext.PingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
            <Grid>
                <TextBlock Text="{Binding PingMs, Converter={StaticResource PingText}}"
                           Foreground="{Binding PingMs, Converter={StaticResource PingBrush}}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Right"
                           ToolTip="{Binding PingTip}"
                           Visibility="{Binding ShowPingValue, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{loc:Tr S0078}" FontSize="12" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right"
                           ToolTip="{Binding PingTip}"
                           Visibility="{Binding PingFailed, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{loc:Tr S0079}" Style="{StaticResource TxtMuted}" HorizontalAlignment="Right"
                           Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}" />
            </Grid>
            </Button>
        </DataTemplate>

        <!-- ======================= сервис ======================= -->
        <DataTemplate x:Key="ServiceTemplate">
            <Border Style="{StaticResource DpiCard}">
                <Grid x:Name="EntryHeader" Height="62" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ручка перетаскивания: ярче при наведении на строку -->
                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeNS"
                            ToolTip="{loc:Tr S0081}">
                        <Path Width="8" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource TextMuted}"
                              Data="M1.5,0.8 A1.2,1.2 0 1 1 1.5,3.2 A1.2,1.2 0 1 1 1.5,0.8 Z M6.5,0.8 A1.2,1.2 0 1 1 6.5,3.2 A1.2,1.2 0 1 1 6.5,0.8 Z M1.5,5.8 A1.2,1.2 0 1 1 1.5,8.2 A1.2,1.2 0 1 1 1.5,5.8 Z M6.5,5.8 A1.2,1.2 0 1 1 6.5,8.2 A1.2,1.2 0 1 1 6.5,5.8 Z M1.5,10.8 A1.2,1.2 0 1 1 1.5,13.2 A1.2,1.2 0 1 1 1.5,10.8 Z M6.5,10.8 A1.2,1.2 0 1 1 6.5,13.2 A1.2,1.2 0 1 1 6.5,10.8 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=EntryHeader}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Border>

                    <!-- значок сервиса: скачанный у сайта либо общий глобус; нажатие открывает сайт -->
                    <Button Grid.Column="1" Style="{StaticResource DpiRowButton}" VerticalAlignment="Center"
                            ToolTip="{loc:Tr dpi.openSite}"
                            Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                    <Border Style="{StaticResource DpiTile}">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                   Visibility="{Binding Icon, Converter={StaticResource NotNullToVis}}" />
                            <Viewbox Width="18" Height="18"
                                     Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource DpiGlobeGeometry}"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                    </Button>

                    <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DpiName}" />
                        <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DomainsTip}">
                            <Run Text="{Binding DomainText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource Accent}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- пинг сервиса: ответ сервера на наш ClientHello -->
                    <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource PingCell}"
                                      Margin="0,0,10,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ToggleButton Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled}" ToolTip="{Binding EnabledHint}" />
                        <Button Style="{StaticResource BtnIcon}" Margin="6,0,0,0" ToolTip="{loc:Tr S0085}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Path Data="M 6,0.6 L 7.6,4.2 L 11.5,4.6 L 8.6,7.2 L 9.4,11 L 6,9 L 2.6,11 L 3.4,7.2 L 0.5,4.6 L 4.4,4.2 Z"
                                  Stretch="Uniform" Width="13" Height="13">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
                                        <Setter Property="StrokeThickness" Value="1.2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="{loc:Tr dpi.refreshIcon}"
                                Command="{Binding DataContext.RefreshIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M11,4.4 A5.2,5.2 0 1 0 12.2,8.6 M11,4.4 H14 M11,4.4 V1.4" />
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="{loc:Tr S0082}"
                                Command="{Binding DataContext.EditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondary}"
                                  Data="M 8.9,1.4 L 10.6,3.1 L 4.1,9.6 L 1.6,10.4 L 2.4,7.9 Z" />
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" ToolTip="{loc:Tr S0083}"
                                Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource Warning}"
                                  Data="M 2.6,2.6 L 9.4,9.4 M 9.4,2.6 L 2.6,9.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- заголовок по центру — как в «Настройках» и «DNS» -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{loc:Tr dpi.title}" Style="{StaticResource TxtH1}" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ListScroll" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="0,0,0,16">
                <!-- заголовок вкладки, пинг всех сервисов и «Добавить сервис» -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{loc:Tr dpi.window.service}" Style="{StaticResource TxtH2}" />
                        <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{loc:Tr dpi.subtitle}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource TxtMuted}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Accent}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top" Height="27">
                        <!-- пинг всех сервисов — та же кнопка, что «Пинг всех профилей» и «Пинг всех DNS» -->
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding PingAllCommand}" Height="27" Width="34"
                                Padding="0" ToolTip="{loc:Tr dpi.pingAll}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform" Data="M1,8 H4.2 L6,3 L8.5,12.5 L10.3,8 H14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddServiceCommand}"
                                Height="27" Padding="10,0,12,0" Margin="8,0,0,0" ToolTip="{loc:Tr dpi.add}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="11" Height="11" Stretch="Uniform" Data="M8,2.5 V13.5 M2.5,8 H13.5" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock Text="{loc:Tr dpi.add}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- права администратора: без них фейк-пакет не может попасть в тот же поток,
                     и самые сильные приёмы обхода (fake/seqovl) ослабляются -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0"
                        Background="{DynamicResource WarningSoft}"
                        Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Tr dpi.admin.title}" Style="{StaticResource Txt}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:Tr dpi.admin.hint}" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Height="27" Padding="10,0"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Content="{loc:Tr dpi.admin.restart}"
                                Command="{Binding RestartElevatedCommand}"
                                ToolTip="{loc:Tr dpi.admin.hint}" />
                    </Grid>
                </Border>

                <!-- «Общие»: набор приёмов для всего трафика. Стоит над сервисами: включён —
                     приёмы применяются ко всему, выключен — только к сервисам ниже -->
                <Border Style="{StaticResource DpiCard}" Margin="0,14,0,0" DataContext="{Binding General}"
                        ToolTip="{Binding EnabledHint}">
                    <Grid Height="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DpiTile}" Margin="14,0,0,0">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource DpiGlobeGeometry}"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DpiName}" />
                            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DnsText}">
                                <Run Text="{Binding DomainText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" Foreground="{DynamicResource Accent}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <ToggleButton Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Enabled}" ToolTip="{Binding EnabledHint}" />
                            <Button Style="{StaticResource BtnIcon}" Margin="6,0,0,0" ToolTip="{loc:Tr dpi.generalEdit}"
                                    Command="{Binding DataContext.EditGeneralCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondary}"
                                      Data="M 8.9,1.4 L 10.6,3.1 L 4.1,9.6 L 1.6,10.4 L 2.4,7.9 Z" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- сервисов ещё нет — как пользоваться -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0"
                        Visibility="{Binding HasServices, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DpiTile}" VerticalAlignment="Top">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource DpiGlobeGeometry}"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{loc:Tr dpi.empty.title}" Style="{StaticResource Txt}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:Tr dpi.empty.hint}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- список сервисов: строки перетаскиваются мышью (DpiView.xaml.cs) -->
                <ItemsControl x:Name="EntryList" Margin="0,14,0,0" ItemsSource="{Binding Services}"
                              ItemTemplate="{StaticResource ServiceTemplate}"
                              PreviewMouseLeftButtonDown="OnEntryPreviewMouseDown"
                              PreviewMouseMove="OnEntryPreviewMouseMove"
                              PreviewMouseLeftButtonUp="OnEntryPreviewMouseUp"
                              LostMouseCapture="OnEntryLostCapture" />

                <!-- как это работает и где живут общие настройки приёмов -->
                <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="2,6,2,0"
                           Text="{loc:Tr dpi.footer}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
