<UserControl x:Class="VibeTun.Views.ConnectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls">
    <!-- карточка управления подключением: сайдбар главного окна и мини-панель у трея
         (TrayPanelWindow). Внешние отступы задаются в месте вставки. -->
    <Border Style="{StaticResource Card}" Padding="14,12,14,12">
        <StackPanel>
            <!-- переключатель режима: обычный прокси или обход DPI -->
            <Border Background="{DynamicResource CardBgAlt}" CornerRadius="9" Padding="3" Margin="0,0,0,12">
                <!-- выбранный режим подсвечивается общей плашкой, которая переезжает между половинами -->
                <Grid ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Style="{StaticResource TabToggleCompact}" Content="Proxy"
                                  HorizontalAlignment="Stretch"
                                  IsChecked="{Binding ConnectionTabIsProxy}" />
                    <ToggleButton Grid.Column="1" Style="{StaticResource TabToggleCompact}" Content="DPI bypass"
                                  Margin="3,0,0,0" HorizontalAlignment="Stretch"
                                  IsChecked="{Binding ConnectionTabIsDpi}" />
                </Grid>
            </Border>

            <!-- страницы режима листаются друг за другом; высота карточки плавно подстраивается -->
            <ctl:SlideHost SelectedKey="{Binding ConnectionTab}" AnimateHeight="True">
            <!-- ============================ вкладка Proxy ============================ -->
            <StackPanel ctl:SlideHost.Key="proxy">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <Binding Path="StatusBrushKey" Converter="{StaticResource BrushKey}" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StateText}" Margin="8,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActivePingText}" Margin="8,0,0,0" Style="{StaticResource TxtMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Content="{Binding ProxyToggleText}" Command="{Binding ToggleProxyCommand}"
                        Style="{StaticResource BtnPrimary}" Height="38" Margin="0,12,0,0" />
                <Button Content="{loc:Tr S0001}" Command="{Binding TelegramProxyCommand}"
                        Style="{StaticResource BtnGhost}" Height="30" Margin="0,8,0,0" FontSize="12"
                        Visibility="{Binding IsTelegramProfile, Converter={StaticResource BoolToVis}}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{loc:Tr S0002}" Style="{StaticResource TxtCaption}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Tr S0003}"
                               Style="{StaticResource TxtCaption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="{Binding TrafficUploadText}" Style="{StaticResource TxtMono}"
                               Margin="0,3,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UptimeText}"
                               Style="{StaticResource TxtMono}" Margin="0,3,0,0" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="2" Text="{Binding TrafficDownloadText}" Style="{StaticResource TxtMono}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectionCountText}"
                               Style="{StaticResource TxtMuted}" HorizontalAlignment="Right" TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- ========================== вкладка DPI bypass ========================== -->
            <StackPanel ctl:SlideHost.Key="dpi">
                <!-- «Сломано» / «Накрыт» — там же, где у прокси «Подключено»; пинга здесь нет -->
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <Binding Path="DpiBrushKey" Converter="{StaticResource BrushKey}" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding DpiStateText}" Margin="8,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Content="{Binding DpiToggleText}" Command="{Binding ToggleDpiCommand}"
                        Style="{StaticResource BtnPrimary}" Height="38" Margin="0,12,0,0" />
                <!-- «DPI тест», «Диагностика» и «Открыть DPI» убраны: всё это живёт в разделе «DPI» слева -->

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr S0008}" Style="{StaticResource TxtCaption}" />
                        <TextBlock Text="{Binding DpiPortText}" Style="{StaticResource TxtMono}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{loc:Tr S0003}" Style="{StaticResource TxtCaption}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DpiUptimeText}" Style="{StaticResource TxtMono}" Margin="0,3,0,0"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding DpiStrategiesText}" Style="{StaticResource TxtMuted}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{loc:Tr S0009}" />
                <TextBlock Style="{StaticResource TxtMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding DpiTrafficText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DpiSessionsText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            </ctl:SlideHost>
        </StackPanel>
    </Border>
</UserControl>
