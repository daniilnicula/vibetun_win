<UserControl x:Class="VibeTun.Views.SshPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls"
             Loaded="OnLoaded">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- строка подключения -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="170" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="HostBox" Style="{StaticResource InputBox}" Tag="user@192.168.1.1"
                     VerticalContentAlignment="Center" />
            <TextBox x:Name="PortBox" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource InputBox}" Tag="22"
                     VerticalContentAlignment="Center" />

            <!-- размер текста внутри терминала: полоска как у прозрачности в пикере акцента -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr S0251}" Style="{StaticResource TxtMuted}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ctl:AlphaBar x:Name="FontBar" Width="120" Height="14" VerticalAlignment="Center"
                              AlphaChanged="OnFontBar" ToolTip="{loc:Tr S0251}" />
                <TextBlock x:Name="FontValue" Style="{StaticResource TxtMuted}" Margin="10,0,0,0"
                           VerticalAlignment="Center" MinWidth="14" />
            </StackPanel>

            <!-- подключиться / отключиться: только иконки -->
            <Button x:Name="ConnectBtn" Grid.Column="3" Margin="18,0,0,0" Style="{StaticResource BtnIcon}"
                    Click="OnConnectClick" ToolTip="{loc:Tr S0158}">
                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{DynamicResource Accent}"
                      Data="M7,1.6 V7.4 M3.2,3.6 A5.2,5.2 0 1 0 10.8,3.6" />
            </Button>
            <Button x:Name="DisconnectBtn" Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource BtnIcon}"
                    Click="OnDisconnectClick" ToolTip="{loc:Tr S0252}" IsEnabled="False">
                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource TextSecondary}"
                      Data="M3,3 L10,10 M10,3 L3,10" />
            </Button>
        </Grid>

        <!-- интерактивный терминал ssh (как в PuTTY): ввод идёт прямо в консоль -->
        <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource InputBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <RichTextBox x:Name="Term" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         Background="Transparent" BorderThickness="0" Padding="12,8"
                         Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="OnTermKeyDown" PreviewTextInput="OnTermTextInput" />
        </Border>
    </Grid>
</UserControl>
