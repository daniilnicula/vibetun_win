<UserControl x:Class="VibeTun.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VibeTun.Services"
             xmlns:ctl="clr-namespace:VibeTun.Views.Controls">
    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Tr S0135}" Style="{StaticResource TxtH1}" />
            <TextBlock Text="{loc:Tr S0161}"
                       Style="{StaticResource TxtMuted}" Margin="0,3,0,0" />
            <TextBlock Text="{loc:Tr S0162}"
                       Style="{StaticResource TxtMuted}" Margin="0,2,0,0" FontStyle="Italic" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== профили входа ==================== -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{loc:Tr S0163}" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnIcon}" Content="+" FontSize="15" Command="{Binding NewProfileCommand}"
                                ToolTip="{loc:Tr S0164}" />
                        <Button Style="{StaticResource BtnIcon}" Content="✕" FontSize="11" Margin="2,0,0,0"
                                Command="{Binding DeleteProfileCommand}" ToolTip="{loc:Tr S0165}" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" Margin="0,8,0,0" MaxHeight="132" Style="{StaticResource ListNav}"
                         ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource TxtMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,12" DataContext="{Binding SelectedProfile}">
                        <TextBlock Text="{loc:Tr S0166}" Style="{StaticResource TxtCaption}" Margin="2,0,0,8" />

                        <TextBlock Text="{loc:Tr S0027}" Style="{StaticResource TxtMuted}" />
                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr S0167}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding ListenAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Tr S0008}" Style="{StaticResource TxtMuted}" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                         Text="{Binding ListenPort, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Tr S0168}" Style="{StaticResource TxtMuted}" Margin="0,10,0,4" />
                        <ComboBox Style="{StaticResource Combo}" SelectedValuePath="Tag" SelectedValue="{Binding Mode}">
                            <ComboBoxItem Content="Mixed (HTTP + SOCKS)" Tag="Mixed" />
                            <ComboBoxItem Content="SOCKS5" Tag="Socks" />
                            <ComboBoxItem Content="HTTP" Tag="Http" />
                        </ComboBox>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Tr S0169}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UseSystemProxy}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:Tr S0170}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding TunEnabled}" />
                        </Grid>
                        <TextBlock Text="{loc:Tr S0171}"
                                   Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding TunEnabled, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding TunEnabled, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{loc:Tr S0172}" Style="{StaticResource TxtMuted}" />
                            <ComboBox Style="{StaticResource Combo}" Margin="0,4,0,0" SelectedValuePath="Tag"
                                      SelectedValue="{Binding TunStack}">
                                <ComboBoxItem Content="system" Tag="system" />
                                <ComboBoxItem Content="gvisor" Tag="gvisor" />
                                <ComboBoxItem Content="mixed" Tag="mixed" />
                            </ComboBox>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MTU" Style="{StaticResource TxtMuted}" />
                                    <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Width="80"
                                             Text="{Binding TunMtu, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="Strict route" Style="{StaticResource TxtMuted}" />
                                    <ToggleButton Style="{StaticResource Switch}" Margin="0,6,0,0"
                                                  IsChecked="{Binding TunStrictRoute}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:Tr S0173}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding DirectPrivate}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="{loc:Tr S0174}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding SniffTraffic}" />
                        </Grid>

                        <!-- DNS переехал в отдельный раздел слева — здесь только ссылка туда -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DNS" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{loc:Tr S0175}" Style="{StaticResource TxtMuted}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Tr S0176}" Style="{StaticResource BtnGhost}" Padding="10,4"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding DataContext.OpenDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== правила и приложения ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- выбор набора -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Sets}"
                              SelectedItem="{Binding SelectedSet}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="{loc:Tr S0177}" Style="{StaticResource BtnGhost}" Command="{Binding NewSetCommand}" />
                        <Button Content="{loc:Tr S0178}" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Command="{Binding DuplicateSetCommand}" />
                        <Button Content="{loc:Tr S0179}" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Command="{Binding ImportSetCommand}" />
                        <Button Content="{loc:Tr S0180}" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Command="{Binding ExportSetCommand}" />
                        <Button Content="{loc:Tr S0083}" Style="{StaticResource BtnDanger}" Margin="6,0,0,0" Command="{Binding DeleteSetCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource TxtMuted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding SelectedSet.Description, TargetNullValue=''}">
                </TextBlock>

                <!-- вкладки «Домены и IP» и «Приложения»: по центру, шириной не больше 700 -->
                <Grid Grid.Row="2" Margin="0,12,0,0" MaxWidth="700" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- переключатель вкладок: одна вкладка всегда выбрана -->
                    <Border Grid.Row="0" HorizontalAlignment="Center" Padding="3" CornerRadius="10"
                            Background="{DynamicResource CardBgAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1">
                        <Grid ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="8">
                            <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource TabToggle}" Content="{loc:Tr S0181}"
                                          IsChecked="{Binding IsDomainsTab}" />
                            <ToggleButton Style="{StaticResource TabToggle}" Content="{loc:Tr S0102}" Margin="3,0,0,0"
                                          IsChecked="{Binding IsAppsTab}" />
                        </StackPanel>
                        </Grid>
                    </Border>

                    <ctl:SlideHost Grid.Row="1" Margin="0,12,0,0" SelectedKey="{Binding RoutingTab}">
                        <!-- домены, IP, regex -->
                        <ScrollViewer ctl:SlideHost.Key="domains" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,14">
                                <TextBlock Text="{loc:Tr S0181}" Style="{StaticResource TxtH2}" />
                                <TextBlock Style="{StaticResource TxtMuted}" Margin="0,3,0,10" TextWrapping="Wrap"
                                           Text="{loc:Tr S0182}" />

                                <!-- добавление правила -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource InputBox}" Tag="vk, youtube.com, 91.108.56.0/24"
                                             Text="{Binding NewRulePattern, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid Grid.Column="1" Margin="8,0,0,0" ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="7">
                                        <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NewRuleKindLabel}" Style="{StaticResource TxtMuted}"
                                                   Width="58" VerticalAlignment="Center" />
                                        <ToggleButton Style="{StaticResource SegToggle}" Content="PROXY"
                                                      IsChecked="{Binding NewRuleIsProxy}" />
                                        <ToggleButton Style="{StaticResource SegToggleNeutral}" Content="DIRECT" Margin="2,0,0,0"
                                                      IsChecked="{Binding NewRuleIsDirect}" />
                                        <ToggleButton Style="{StaticResource SegToggleWarn}" Content="BLOCK" Margin="2,0,0,0"
                                                      IsChecked="{Binding NewRuleIsBlock}" />
                                        <Button Content="{loc:Tr S0029}" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                                Command="{Binding AddRuleCommand}" />
                                    </StackPanel>
                                    </Grid>
                                </Grid>

                                <TextBlock Text="{Binding RulesCountText}" Style="{StaticResource TxtMuted}" Margin="2,10,0,6" />

                                <!-- список правил -->
                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled}" ToolTip="{loc:Tr S0183}" />

                                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Margin="10,0,0,0"
                                                             Text="{Binding Pattern, UpdateSourceTrigger=LostFocus}" />

                                                    <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Style="{StaticResource TxtMuted}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               ToolTip="{loc:Tr S0184}" />

                                                    <Grid Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="7">
                                                        <StackPanel Orientation="Horizontal">
                                                        <ToggleButton Style="{StaticResource SegToggle}" Content="PROXY"
                                                                      IsChecked="{Binding IsProxy}" />
                                                        <ToggleButton Style="{StaticResource SegToggleNeutral}" Content="DIRECT" Margin="2,0,0,0"
                                                                      IsChecked="{Binding IsDirect}" />
                                                        <ToggleButton Style="{StaticResource SegToggleWarn}" Content="BLOCK" Margin="2,0,0,0"
                                                                      IsChecked="{Binding IsBlock}" />
                                                    </StackPanel>
                                                    </Grid>

                                                    <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="{loc:Tr S0185}">
                                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- приложения -->
                        <ScrollViewer ctl:SlideHost.Key="apps" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="{loc:Tr S0102}" Style="{StaticResource TxtH2}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Style="{StaticResource InputBox}" Width="150" Tag="{loc:Tr Search}"
                                                 Text="{Binding AppSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                        <Button Content="{loc:Tr S0122}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                                Command="{Binding AddAppFromExeCommand}" />
                                        <Button Content="{loc:Tr S0124}" Style="{StaticResource BtnPrimary}" Margin="6,0,0,0"
                                                Command="{Binding AddAppFromProcessesCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="9" Background="{DynamicResource WarningSoft}"
                                        Visibility="{Binding ShowTunHint, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TxtMuted}" TextWrapping="Wrap"
                                                   Text="{loc:Tr S0186}" />
                                        <Button Grid.Column="1" Content="{loc:Tr S0187}" Style="{StaticResource BtnGhost}"
                                                Margin="10,0,0,0" Command="{Binding EnableTunCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FilteredApps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled}" />

                                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Margin="10,0,0,0"
                                                            Background="{DynamicResource CardBgAlt}">
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource TxtMuted}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Grid Grid.Column="3" VerticalAlignment="Center" ctl:SegmentGroup.IsGroup="True" ctl:SegmentGroup.Radius="7">
                                                        <StackPanel Orientation="Horizontal">
                                                        <ToggleButton Style="{StaticResource SegToggle}" Content="PROXY"
                                                                      IsChecked="{Binding IsProxy}" />
                                                        <ToggleButton Style="{StaticResource SegToggleNeutral}" Content="DIRECT" Margin="2,0,0,0"
                                                                      IsChecked="{Binding IsDirect}" />
                                                        <ToggleButton Style="{StaticResource SegToggleWarn}" Content="BLOCK" Margin="2,0,0,0"
                                                                      IsChecked="{Binding IsBlock}" />
                                                    </StackPanel>
                                                    </Grid>

                                                    <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="{loc:Tr S0099}">
                                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </ctl:SlideHost>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
